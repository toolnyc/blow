---
import Layout from '../layouts/Layout.astro';
import Window from '../components/Window.astro';
---

<Layout title="BlowNet ™ — You're In">
  <Window
    title="Confirmation"
    icon="/icons/events.svg"
    showControls={false}
    id="success-window"
  >
    <div class="success-content">
      <img src="/wordmark.svg" alt="Blow" class="wordmark" />
      <p class="message">You're in.</p>
      <p class="hint">Check your email for details.</p>
      <a href="/" class="back-link">
        <button>Back to BlowNet</button>
      </a>
    </div>
  </Window>
</Layout>

<style>
  :global(.desktop) {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 80px;
  }

  .success-content {
    text-align: center;
    padding: 20px;
  }

  .wordmark {
    max-width: 200px;
    height: auto;
    margin-bottom: 16px;
  }

  .message {
    font-size: 18px;
    font-weight: bold;
    color: #ff2845;
    margin: 16px 0 8px;
  }

  .hint {
    color: #808080;
    margin: 4px 0;
  }

  .back-link {
    display: inline-block;
    margin-top: 16px;
    text-decoration: none;
  }
</style>

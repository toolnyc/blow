---
import Stripe from 'stripe';
import Layout from '../layouts/Layout.astro';
import Window from '../components/Window.astro';
import { requireEnv } from '../lib/env';

export const prerender = false;

const url = new URL(Astro.request.url);
const sessionId = url.searchParams.get('session_id');
let isDonation = false;

if (sessionId) {
  try {
    const stripe = new Stripe(requireEnv('STRIPE_SECRET_KEY'));
    const session = await stripe.checkout.sessions.retrieve(sessionId);
    isDonation = session.metadata?.type === 'donation';
  } catch {
    // fall through to default (ticket) variant
  }
}
---

<Layout title="BlowNet ™ — You're In">
  <Window
    title="Confirmation"
    icon="/icons/events.svg"
    showControls={false}
    id="success-window"
  >
    <div class="success-content">
      <img src="/wordmark.svg" alt="Blow" class="wordmark" />
      {isDonation ? (
        <>
          <p class="message">Thanks for your support.</p>
          <p class="hint">Receipt will be sent to your email.</p>
        </>
      ) : (
        <>
          <p class="message">You're in.</p>
          <p class="hint">Check your email for details.</p>
        </>
      )}
      <a href="/" class="back-link">
        <button>Back to BlowNet</button>
      </a>
    </div>
  </Window>
</Layout>

<style>
  :global(.desktop) {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 80px;
  }

  .success-content {
    text-align: center;
    padding: 20px;
  }

  .wordmark {
    max-width: 200px;
    height: auto;
    margin-bottom: 16px;
  }

  .message {
    font-size: 18px;
    font-weight: bold;
    color: #ff2845;
    margin: 16px 0 8px;
  }

  .hint {
    color: #808080;
    margin: 4px 0;
  }

  .back-link {
    display: inline-block;
    margin-top: 16px;
    text-decoration: none;
  }
</style>

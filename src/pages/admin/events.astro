</style>

<script>
  // ── State ──
  let allGuests: Array<Record<string, unknown>> = [];
  let sortCol = 'name';
  let sortDir: 'asc' | 'desc' = 'asc';

  // ── DOM refs ──
  const eventSelect = document.getElementById('event-select') as HTMLSelectElement;
  const loading = document.getElementById('loading') as HTMLDivElement;
  const emptyState = document.getElementById('empty-state') as HTMLDivElement;
  const dashboard = document.getElementById('dashboard') as HTMLDivElement;

  // ── Init: load events list ──
  async function init() {
    try {
      const res = await fetch('/api/events-list');
      if (!res.ok) throw new Error('Failed to load events');
      const data = await res.json();

      if (!data.events || data.events.length === 0) {
        loading.classList.add('hidden');
        emptyState.classList.remove('hidden');
        return;
      }

      eventSelect.innerHTML = '';
      for (const ev of data.events) {
        const opt = document.createElement('option');
        opt.value = ev.event;
        opt.textContent = `${ev.event} (${ev.guestCount} guests)`;
        eventSelect.appendChild(opt);
      }

      // Check URL param
      const urlParams = new URLSearchParams(window.location.search);
      const urlEvent = urlParams.get('event');
      if (urlEvent && data.events.some((e: Record<string, unknown>) => e.event === urlEvent)) {
        eventSelect.value = urlEvent;
      }

      await loadEvent(eventSelect.value);
    } catch (err) {
      loading.classList.add('hidden');
      emptyState.classList.remove('hidden');
      const p = emptyState.querySelector('p');
      if (p) p.textContent = 'Failed to load events. Are you logged in?';
    }
  }

  eventSelect.addEventListener('change', () => {
    const event = eventSelect.value;
    const url = new URL(window.location.href);
    url.searchParams.set('event', event);
    window.history.replaceState({}, '', url.toString());
    loadEvent(event);
  });

  // ── Load event data ──
  async function loadEvent(event: string) {
    loading.classList.remove('hidden');
    dashboard.classList.add('hidden');

    try {
      const [statsRes, guestsRes] = await Promise.all([
        fetch(`/api/event-stats?event=${encodeURIComponent(event)}`),
        fetch(`/api/event-guests?event=${encodeURIComponent(event)}`),
      ]);

      if (!statsRes.ok || !guestsRes.ok) throw new Error('Failed to load data');

      const stats = await statsRes.json();
      const guestsData = await guestsRes.json();
      allGuests = guestsData.guests;

      renderStats(stats.summary);
      renderChart(stats.arrivals);
      renderRevenue(stats.tierBreakdown, stats.summary.totalRevenue);
      renderInsights(stats.insights);
      renderGuests();

      if (stats.peakTime) {
        const badge = document.getElementById('peak-badge');
        if (badge) badge.textContent = `Peak: ${stats.peakTime} (${stats.peakCount})`;
      }

      loading.classList.add('hidden');
      dashboard.classList.remove('hidden');
    } catch (err) {
      loading.classList.add('hidden');
      dashboard.classList.remove('hidden');
    }
  }

  // ── Render: Stats ──
  function renderStats(s: Record<string, unknown>) {
    setText('stat-total', String(s.totalGuests));
    setText('stat-checked', String(s.checkedIn));
    setText('stat-showrate', `${s.showRate}%`);
    setText('stat-walkins', `${s.walkInCount}`);
    setText('stat-walkins-sub', `of ${s.walkInLimit} limit`);
    setText('stat-revenue', formatDollars(s.totalRevenue as number));
  }

  // ── Render: SVG Chart ──
  function renderChart(arrivals: Array<{ time: string; count: number; cumulative: number }>) {
    const svg = document.getElementById('arrival-chart') as unknown as SVGSVGElement;
    const chartEmpty = document.getElementById('chart-empty') as HTMLDivElement;

    // Clear previous
    while (svg.firstChild) svg.removeChild(svg.firstChild);

    if (!arrivals || arrivals.length === 0) {
      svg.style.display = 'none';
      chartEmpty.classList.remove('hidden');
      return;
    }

    svg.style.display = '';
    chartEmpty.classList.add('hidden');

    const W = 600;
    const H = 200;
    const padL = 40;
    const padR = 14;
    const padT = 14;
    const padB = 30;
    const chartW = W - padL - padR;
    const chartH = H - padT - padB;

    const maxVal = Math.max(...arrivals.map((a) => a.cumulative), 1);
    const n = arrivals.length;

    // Grid lines
    const gridLines = 4;
    for (let i = 0; i <= gridLines; i++) {
      const y = padT + (chartH / gridLines) * i;
      const val = Math.round(maxVal - (maxVal / gridLines) * i);
      const line = svgEl('line', {
        x1: String(padL),
        y1: String(y),
        x2: String(W - padR),
        y2: String(y),
        stroke: '#1a1a25',
        'stroke-width': '1',
      });
      svg.appendChild(line);

      const label = svgEl('text', {
        x: String(padL - 6),
        y: String(y + 3),
        fill: '#555566',
        'font-size': '9',
        'font-family': "'Courier New', monospace",
        'text-anchor': 'end',
      });
      label.textContent = String(val);
      svg.appendChild(label);
    }

    // Area + line
    const points: string[] = [];
    const xStep = n > 1 ? chartW / (n - 1) : 0;

    for (let i = 0; i < n; i++) {
      const x = padL + (n > 1 ? xStep * i : chartW / 2);
      const y = padT + chartH - (arrivals[i].cumulative / maxVal) * chartH;
      points.push(`${x},${y}`);
    }

    // Area fill
    const areaPoints = [
      `${padL + (n > 1 ? 0 : chartW / 2)},${padT + chartH}`,
      ...points,
      `${padL + (n > 1 ? xStep * (n - 1) : chartW / 2)},${padT + chartH}`,
    ];
    const area = svgEl('polygon', {
      points: areaPoints.join(' '),
      fill: 'rgba(255, 40, 69, 0.08)',
    });
    svg.appendChild(area);

    // Line
    const polyline = svgEl('polyline', {
      points: points.join(' '),
      fill: 'none',
      stroke: '#ff2845',
      'stroke-width': '2',
      'stroke-linejoin': 'round',
    });
    svg.appendChild(polyline);

    // Data dots
    for (let i = 0; i < n; i++) {
      const x = padL + (n > 1 ? xStep * i : chartW / 2);
      const y = padT + chartH - (arrivals[i].cumulative / maxVal) * chartH;
      const dot = svgEl('circle', {
        cx: String(x),
        cy: String(y),
        r: '3',
        fill: '#ff2845',
      });
      svg.appendChild(dot);
    }

    // X-axis labels (show every Nth to avoid overlap)
    const labelEvery = Math.max(1, Math.ceil(n / 8));
    for (let i = 0; i < n; i += labelEvery) {
      const x = padL + (n > 1 ? xStep * i : chartW / 2);
      const label = svgEl('text', {
        x: String(x),
        y: String(H - 6),
        fill: '#555566',
        'font-size': '9',
        'font-family': "'Courier New', monospace",
        'text-anchor': 'middle',
      });
      label.textContent = arrivals[i].time;
      svg.appendChild(label);
    }

    // Bar chart overlay for per-interval count (subtle)
    const barMaxVal = Math.max(...arrivals.map((a) => a.count), 1);
    const barW = Math.max(4, (chartW / n) * 0.6);
    for (let i = 0; i < n; i++) {
      const x = padL + (n > 1 ? xStep * i : chartW / 2) - barW / 2;
      const barH = (arrivals[i].count / barMaxVal) * (chartH * 0.3);
      const y = padT + chartH - barH;
      const bar = svgEl('rect', {
        x: String(x),
        y: String(y),
        width: String(barW),
        height: String(barH),
        fill: 'rgba(255, 40, 69, 0.15)',
        rx: '1',
      });
      svg.appendChild(bar);
    }
  }

  function svgEl(tag: string, attrs: Record<string, string>): SVGElement {
    const el = document.createElementNS('http://www.w3.org/2000/svg', tag);
    for (const [k, v] of Object.entries(attrs)) {
      el.setAttribute(k, v);
    }
    return el;
  }

  // ── Render: Revenue ──
  function renderRevenue(
    tiers: Record<string, { count: number; tickets: number; revenue: number }>,
    totalRevenue: number
  ) {
    const tbody = document.getElementById('revenue-body') as HTMLTableSectionElement;
    tbody.innerHTML = '';

    let totalBookings = 0;
    let totalTickets = 0;

    const tierEntries = Object.entries(tiers).sort((a, b) => b[1].revenue - a[1].revenue);

    for (const [name, data] of tierEntries) {
      totalBookings += data.count;
      totalTickets += data.tickets;
      const avg = data.count > 0 ? Math.round(data.revenue / data.count) : 0;
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td>${esc(name)}</td>
        <td class="num">${data.count}</td>
        <td class="num">${data.tickets}</td>
        <td class="num">${formatDollars(data.revenue)}</td>
        <td class="num">${formatDollars(avg)}</td>
      `;
      tbody.appendChild(tr);
    }

    setText('rev-total-bookings', String(totalBookings));
    setText('rev-total-tickets', String(totalTickets));
    setText('rev-total-revenue', formatDollars(totalRevenue));
  }

  // ── Render: Insights ──
  function renderInsights(ins: Record<string, unknown>) {
    const list = document.getElementById('insights-list') as HTMLDivElement;
    list.innerHTML = '';

    const items: Array<{ icon: string; text: string }> = [];

    if (ins.peakTime) {
      items.push({
        icon: 'clock',
        text: `Peak arrival was at <span class="ea-insight-value">${esc(String(ins.peakTime))}</span> (${ins.peakCount} check-ins)`,
      });
    }

    if (typeof ins.beforeMidnightPct === 'number') {
      items.push({
        icon: 'moon',
        text: `<span class="ea-insight-value">${ins.beforeMidnightPct}%</span> of guests arrived before midnight`,
      });
    }

    if (typeof ins.noShowCount === 'number' && ins.noShowCount > 0) {
      items.push({
        icon: 'x',
        text: `<span class="ea-insight-value">${ins.noShowCount}</span> no-shows (<span class="ea-insight-value">${ins.noShowRate}%</span> of pre-sale)`,
      });
    }

    if (typeof ins.walkInCount === 'number') {
      items.push({
        icon: 'plus',
        text: `Walk-ins filled <span class="ea-insight-value">${ins.walkInCount}</span> of <span class="ea-insight-value">${ins.walkInLimit}</span> slots`,
      });
    }

    for (const item of items) {
      const div = document.createElement('div');
      div.className = 'ea-insight';
      div.innerHTML = `${getSvgIcon(item.icon)}<span>${item.text}</span>`;
      list.appendChild(div);
    }
  }

  function getSvgIcon(name: string): string {
    const icons: Record<string, string> = {
      clock: '<svg class="ea-insight-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6.5"/><path d="M8 4v4l2.5 1.5"/></svg>',
      moon: '<svg class="ea-insight-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13.5 9.5a5.5 5.5 0 01-7-7 5.5 5.5 0 107 7z"/></svg>',
      x: '<svg class="ea-insight-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6.5"/><path d="M5.5 5.5l5 5M10.5 5.5l-5 5"/></svg>',
      plus: '<svg class="ea-insight-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6.5"/><path d="M8 5v6M5 8h6"/></svg>',
    };
    return icons[name] ?? '';
  }

  // ── Render: Guest list ──
  function renderGuests() {
    const tbody = document.getElementById('guest-body') as HTMLTableSectionElement;
    const emptyEl = document.getElementById('guest-empty') as HTMLDivElement;
    const countLabel = document.getElementById('guest-count-label') as HTMLSpanElement;
    tbody.innerHTML = '';

    const searchVal = (document.getElementById('guest-search') as HTMLInputElement).value.toLowerCase().trim();
    const filterVal = (document.getElementById('guest-filter') as HTMLSelectElement).value;

    let filtered = allGuests.slice();

    // Apply filter
    if (filterVal === 'checked-in') {
      filtered = filtered.filter((g) => (g.checked_in_count as number) > 0);
    } else if (filterVal === 'no-show') {
      filtered = filtered.filter((g) => (g.checked_in_count as number) === 0);
    } else if (filterVal === 'walk-in') {
      filtered = filtered.filter((g) => g.ticket_type === 'Walk-in');
    }

    // Apply search
    if (searchVal) {
      filtered = filtered.filter((g) =>
        (g.name as string).toLowerCase().includes(searchVal) ||
        ((g.ticket_type as string) || '').toLowerCase().includes(searchVal)
      );
    }

    // Sort
    filtered.sort((a, b) => {
      let aVal = a[sortCol];
      let bVal = b[sortCol];

      if (sortCol === 'first_checked_in_at') {
        aVal = aVal ? new Date(aVal as string).getTime() : 0;
        bVal = bVal ? new Date(bVal as string).getTime() : 0;
      }

      if (typeof aVal === 'number' && typeof bVal === 'number') {
        return sortDir === 'asc' ? aVal - bVal : bVal - aVal;
      }

      const aStr = String(aVal ?? '').toLowerCase();
      const bStr = String(bVal ?? '').toLowerCase();
      const cmp = aStr.localeCompare(bStr);
      return sortDir === 'asc' ? cmp : -cmp;
    });

    if (filtered.length === 0) {
      emptyEl.classList.remove('hidden');
    } else {
      emptyEl.classList.add('hidden');
    }

    for (const g of filtered) {
      const isNoShow = (g.checked_in_count as number) === 0 && g.ticket_type !== 'Walk-in';
      const isWalkin = g.ticket_type === 'Walk-in';
      const tr = document.createElement('tr');
      if (isNoShow) tr.className = 'no-show';
      if (isWalkin) tr.classList.add('walkin-row');

      const arrivalTime = g.first_checked_in_at
        ? formatTime(new Date(g.first_checked_in_at as string))
        : '--';

      const ticketLabel = g.ticket_type === 'Walk-in'
        ? `<span class="ea-pill ea-pill-walkin">Walk-in</span>`
        : esc(String(g.ticket_type || 'Unknown'));

      tr.innerHTML = `
        <td>${esc(String(g.name))}</td>
        <td>${ticketLabel}</td>
        <td class="num">${g.tickets}</td>
        <td class="num">${g.checked_in_count}/${g.tickets}</td>
        <td>${arrivalTime}</td>
      `;
      tbody.appendChild(tr);
    }

    countLabel.textContent = `${filtered.length} guest${filtered.length !== 1 ? 's' : ''}`;

    // Update sort indicators
    document.querySelectorAll('.ea-guest-table th.sortable').forEach((th) => {
      th.classList.remove('sort-asc', 'sort-desc');
      if ((th as HTMLElement).dataset.col === sortCol) {
        th.classList.add(sortDir === 'asc' ? 'sort-asc' : 'sort-desc');
      }
    });
  }

  // ── Sorting ──
  document.querySelectorAll('.ea-guest-table th.sortable').forEach((th) => {
    th.addEventListener('click', () => {
      const col = (th as HTMLElement).dataset.col ?? 'name';
      if (sortCol === col) {
        sortDir = sortDir === 'asc' ? 'desc' : 'asc';
      } else {
        sortCol = col;
        sortDir = 'asc';
      }
      renderGuests();
    });
  });

  // ── Filtering ──
  const guestSearch = document.getElementById('guest-search') as HTMLInputElement;
  const guestFilter = document.getElementById('guest-filter') as HTMLSelectElement;
  guestSearch.addEventListener('input', () => renderGuests());
  guestFilter.addEventListener('change', () => renderGuests());

  // ── Helpers ──
  function setText(id: string, text: string) {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  }

  function formatDollars(cents: number): string {
    if (cents === 0) return '$0';
    return '$' + (cents / 100).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function formatTime(d: Date): string {
    const h = d.getHours();
    const m = d.getMinutes().toString().padStart(2, '0');
    const ampm = h >= 12 ? 'PM' : 'AM';
    const h12 = h % 12 || 12;
    return `${h12}:${m} ${ampm}`;
  }

  function esc(str: string): string {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  // ── Boot ──
  // Only init analysis when that tab is shown
  let analysisInitialized = false;

  // ═══ Tab Switching ═══
  const tabs = document.querySelectorAll('.ev-tab') as NodeListOf<HTMLButtonElement>;
  const tabManage = document.getElementById('tab-manage') as HTMLDivElement;
  const tabAnalysis = document.getElementById('tab-analysis') as HTMLDivElement;

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tab;
      tabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');

      if (target === 'manage') {
        tabManage.classList.remove('hidden');
        tabAnalysis.classList.add('hidden');
      } else {
        tabManage.classList.add('hidden');
        tabAnalysis.classList.remove('hidden');
        if (!analysisInitialized) {
          analysisInitialized = true;
          init();
        }
      }
    });
  });

  // ═══ Event Management ═══
  interface ManagedEvent {
    id: string;
    slug: string;
    name: string;
    date: string;
    venue: string | null;
    walk_in_limit: number;
    capacity: number | null;
    stripe_url: string | null;
    created_at: string;
  }

  const btnNew = document.getElementById('btn-new-event') as HTMLButtonElement;
  const formWrap = document.getElementById('event-form-wrap') as HTMLDivElement;
  const formEl = document.getElementById('event-form') as HTMLFormElement;
  const formTitle = document.getElementById('form-title') as HTMLHeadingElement;
  const formMode = document.getElementById('form-mode') as HTMLInputElement;
  const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;
  const btnCancel = document.getElementById('btn-cancel-form') as HTMLButtonElement;
  const feedback = document.getElementById('form-feedback') as HTMLSpanElement;
  const listWrap = document.getElementById('event-list') as HTMLDivElement;
  const listLoading = document.getElementById('event-list-loading') as HTMLDivElement;
  const listEmpty = document.getElementById('event-list-empty') as HTMLDivElement;

  const fieldName = document.getElementById('field-name') as HTMLInputElement;
  const fieldSlug = document.getElementById('field-slug') as HTMLInputElement;
  const fieldDate = document.getElementById('field-date') as HTMLInputElement;
  const fieldVenue = document.getElementById('field-venue') as HTMLInputElement;
  const fieldCapacity = document.getElementById('field-capacity') as HTMLInputElement;
  const fieldWalkinLimit = document.getElementById('field-walkin-limit') as HTMLInputElement;
  const tiersList = document.getElementById('tiers-list') as HTMLDivElement;
  const tierNameInput = document.getElementById('tier-name') as HTMLInputElement;
  const tierPriceInput = document.getElementById('tier-price') as HTMLInputElement;
  const btnAddTier = document.getElementById('btn-add-tier') as HTMLButtonElement;

  let managedEvents: ManagedEvent[] = [];

  interface TierItem {
    id?: string;
    name: string;
    price_cents: number;
    stripe_price_id?: string;
    active?: boolean;
  }

  let pendingTiers: TierItem[] = [];
  let savedTiers: TierItem[] = [];

  // ── Tier management ──
  btnAddTier.addEventListener('click', () => {
    const name = tierNameInput.value.trim();
    const priceStr = tierPriceInput.value.trim();
    const priceDollars = parseFloat(priceStr);

    if (!name || isNaN(priceDollars) || priceDollars <= 0) return;

    pendingTiers.push({ name, price_cents: Math.round(priceDollars * 100) });
    tierNameInput.value = '';
    tierPriceInput.value = '';
    tierNameInput.focus();
    renderTiers();
  });

  function renderTiers() {
    tiersList.innerHTML = '';
    const allTiers = [...savedTiers.filter(t => t.active !== false), ...pendingTiers];

    for (let i = 0; i < allTiers.length; i++) {
      const t = allTiers[i];
      const isSaved = !!t.id;
      const div = document.createElement('div');
      div.className = 'ev-tier-item';
      div.innerHTML = `
        <span class="ev-tier-item-name">${escManage(t.name)}</span>
        <span class="ev-tier-item-price">$${(t.price_cents / 100).toFixed(0)}</span>
        <span class="ev-tier-item-status ${isSaved ? '' : 'pending'}">${isSaved ? 'LIVE' : 'PENDING'}</span>
      `;

      if (!isSaved) {
        const removeBtn = document.createElement('button');
        removeBtn.className = 'ev-tier-remove';
        removeBtn.type = 'button';
        removeBtn.innerHTML = '&times;';
        const pendingIdx = i - savedTiers.filter(t => t.active !== false).length;
        removeBtn.addEventListener('click', () => {
          pendingTiers.splice(pendingIdx, 1);
          renderTiers();
        });
        div.appendChild(removeBtn);
      }

      tiersList.appendChild(div);
    }
  }

  // Auto-generate slug from name
  fieldName.addEventListener('input', () => {
    if (formMode.value === 'create') {
      const name = fieldName.value;
      // Extract date-like portions or simplify the name
      const slug = name
        .toLowerCase()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '');
      fieldSlug.value = slug;
    }
  });

  // Show new event form
  btnNew.addEventListener('click', () => {
    formMode.value = 'create';
    formTitle.textContent = 'New Event';
    btnSubmit.textContent = 'CREATE EVENT';
    formEl.reset();
    fieldWalkinLimit.value = '30';
    feedback.textContent = '';
    feedback.className = 'ev-feedback';
    pendingTiers = [];
    savedTiers = [];
    renderTiers();
    formWrap.classList.remove('hidden');
    fieldName.focus();
  });

  // Cancel form
  btnCancel.addEventListener('click', () => {
    formWrap.classList.add('hidden');
    feedback.textContent = '';
  });

  // Edit an event — load existing tiers from DB
  async function editEvent(ev: ManagedEvent) {
    formMode.value = 'edit';
    formTitle.textContent = `Edit: ${ev.name}`;
    btnSubmit.textContent = 'SAVE CHANGES';
    fieldName.value = ev.name;
    fieldSlug.value = ev.slug;
    fieldSlug.readOnly = true;
    fieldDate.value = ev.date.slice(0, 10);
    fieldVenue.value = ev.venue ?? '';
    fieldCapacity.value = ev.capacity !== null ? String(ev.capacity) : '';
    fieldWalkinLimit.value = String(ev.walk_in_limit);
    feedback.textContent = '';
    feedback.className = 'ev-feedback';

    // Load tiers for this event
    pendingTiers = [];
    savedTiers = [];
    try {
      const res = await fetch(`/api/ticket-tiers?event=${encodeURIComponent(ev.slug)}`);
      if (res.ok) {
        const data = await res.json();
        savedTiers = (data.tiers ?? []) as TierItem[];
      }
    } catch { /* ignore */ }
    renderTiers();

    formWrap.classList.remove('hidden');
    fieldName.focus();
  }

  // Submit form
  formEl.addEventListener('submit', async (e) => {
    e.preventDefault();
    feedback.textContent = '';
    feedback.className = 'ev-feedback';
    btnSubmit.disabled = true;

    const slug = fieldSlug.value.trim().toLowerCase();
    const name = fieldName.value.trim();
    const date = fieldDate.value;
    const venue = fieldVenue.value.trim();
    const capacity = fieldCapacity.value ? parseInt(fieldCapacity.value, 10) : null;
    const walkInLimit = fieldWalkinLimit.value ? parseInt(fieldWalkinLimit.value, 10) : 30;

    const isEdit = formMode.value === 'edit';
    const method = isEdit ? 'PUT' : 'POST';

    const payload: Record<string, unknown> = { slug, name, date };
    if (venue) payload.venue = venue;
    if (capacity !== null && !isNaN(capacity)) payload.capacity = capacity;
    payload.walk_in_limit = walkInLimit;

    try {
      const res = await fetch('/api/events', {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await res.json();

      if (!res.ok) {
        feedback.textContent = `[ERROR: ${data.error ?? 'Unknown error'}]`;
        feedback.className = 'ev-feedback error';
        btnSubmit.disabled = false;
        return;
      }

      // Create any pending tiers via API
      if (pendingTiers.length > 0) {
        feedback.textContent = '[CREATING TIERS...]';
        let tierErrors = 0;
        for (let i = 0; i < pendingTiers.length; i++) {
          const t = pendingTiers[i];
          try {
            const tierRes = await fetch('/api/ticket-tiers', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                event_slug: slug,
                name: t.name,
                price_cents: t.price_cents,
                sort_order: savedTiers.length + i,
              }),
            });
            if (!tierRes.ok) tierErrors++;
          } catch {
            tierErrors++;
          }
        }
        pendingTiers = [];
        if (tierErrors > 0) {
          feedback.textContent = `[SAVED — ${tierErrors} tier(s) failed]`;
          feedback.className = 'ev-feedback error';
        } else {
          feedback.textContent = '[SAVED]';
          feedback.className = 'ev-feedback success';
        }
      } else {
        feedback.textContent = '[SAVED]';
        feedback.className = 'ev-feedback success';
      }

      btnSubmit.disabled = false;

      // Reset form after create
      if (!isEdit) {
        setTimeout(() => {
          formWrap.classList.add('hidden');
          fieldSlug.readOnly = false;
        }, 800);
      }

      // Refresh list
      await loadManagedEvents();
    } catch {
      feedback.textContent = '[ERROR: Network error]';
      feedback.className = 'ev-feedback error';
      btnSubmit.disabled = false;
    }
  });

  // Load event list
  async function loadManagedEvents() {
    listLoading.classList.remove('hidden');
    listEmpty.classList.add('hidden');
    listWrap.classList.add('hidden');

    try {
      const res = await fetch('/api/events');
      if (!res.ok) throw new Error('Failed');
      const data = await res.json();
      managedEvents = data.events as ManagedEvent[];

      if (managedEvents.length === 0) {
        listLoading.classList.add('hidden');
        listEmpty.classList.remove('hidden');
        return;
      }

      renderEventList();
      listLoading.classList.add('hidden');
      listWrap.classList.remove('hidden');
    } catch {
      listLoading.classList.add('hidden');
      listEmpty.classList.remove('hidden');
      const p = listEmpty.querySelector('p');
      if (p) p.textContent = 'Failed to load events.';
    }
  }

  function renderEventList() {
    listWrap.innerHTML = '';

    for (const ev of managedEvents) {
      const item = document.createElement('div');
      item.className = 'ev-list-item';
      item.setAttribute('role', 'button');
      item.setAttribute('tabindex', '0');

      const dateStr = new Date(ev.date.slice(0, 10) + 'T00:00:00').toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
      });

      const venuePart = ev.venue ? ` / ${escManage(ev.venue)}` : '';
      const capPart = ev.capacity ? ` / cap ${ev.capacity}` : '';

      item.innerHTML = `
        <div class="ev-list-item-left">
          <div class="ev-list-name">${escManage(ev.name)}</div>
          <div class="ev-list-meta">${dateStr}${venuePart}${capPart}</div>
          <div class="ev-list-slug">/${escManage(ev.slug)}</div>
        </div>
        <div class="ev-list-arrow">&rsaquo;</div>
      `;

      item.addEventListener('click', () => editEvent(ev));
      item.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          editEvent(ev);
        }
      });

      listWrap.appendChild(item);
    }
  }

  function escManage(str: string): string {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  // ── Boot manage tab ──
  loadManagedEvents();
</script>

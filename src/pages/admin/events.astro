---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Events — Blow Admin">
  <div class="ea-root">
    <!-- Tab switcher -->
    <div class="ev-tabs">
      <button class="ev-tab active" data-tab="manage">Manage</button>
      <button class="ev-tab" data-tab="analysis">Analysis</button>
    </div>

    <!-- ═══ MANAGE TAB ═══ -->
    <div id="tab-manage" class="ev-tab-content">
      <div class="ev-manage-header">
        <h1 class="ea-title">Events</h1>
        <button id="btn-new-event" class="ev-btn-primary">+ NEW EVENT</button>
      </div>

      <!-- Event form (hidden by default) -->
      <div id="event-form-wrap" class="ev-form-wrap hidden">
        <div class="ea-panel">
          <div class="ea-panel-header">
            <h2 class="ea-panel-title" id="form-title">New Event</h2>
            <button id="btn-cancel-form" class="ev-btn-cancel">CANCEL</button>
          </div>
          <form id="event-form" class="ev-form" autocomplete="off">
            <input type="hidden" id="form-mode" value="create" />
            <div class="ev-field">
              <label class="ev-label" for="field-name">NAME</label>
              <input type="text" id="field-name" class="ev-input" placeholder="Blow — May 3" required />
            </div>
            <div class="ev-field">
              <label class="ev-label" for="field-slug">SLUG</label>
              <input type="text" id="field-slug" class="ev-input" placeholder="may3" required />
              <span class="ev-hint">Lowercase, no spaces. Used in URLs.</span>
            </div>
            <div class="ev-field">
              <label class="ev-label" for="field-date">DATE</label>
              <input type="date" id="field-date" class="ev-input" required />
            </div>
            <div class="ev-field">
              <label class="ev-label" for="field-venue">VENUE</label>
              <input type="text" id="field-venue" class="ev-input" placeholder="TBD" />
            </div>
            <div class="ev-field-row">
              <div class="ev-field">
                <label class="ev-label" for="field-capacity">CAPACITY</label>
                <input type="number" id="field-capacity" class="ev-input" placeholder="200" min="0" />
              </div>
              <div class="ev-field">
                <label class="ev-label" for="field-walkin-limit">WALK-IN LIMIT</label>
                <input type="number" id="field-walkin-limit" class="ev-input" value="30" min="0" />
              </div>
            </div>
            <!-- Ticket Tiers -->
            <div class="ev-tiers-section">
              <div class="ev-label" style="margin-bottom: var(--sp-2)">TICKET TIERS</div>
              <div id="tiers-list" class="ev-tiers-list"></div>
              <div class="ev-tier-add">
                <input type="text" id="tier-name" class="ev-input ev-tier-input" placeholder="Tier name (e.g. Regular)" />
                <input type="number" id="tier-price" class="ev-input ev-tier-input ev-tier-price" placeholder="Price ($)" min="1" step="1" />
                <button type="button" id="btn-add-tier" class="ev-btn-tier-add">+ ADD</button>
              </div>
              <span class="ev-hint">Each tier creates a Stripe product automatically. Prices in USD.</span>
            </div>
            <div class="ev-form-actions">
              <button type="submit" id="btn-submit" class="ev-btn-primary">CREATE EVENT</button>
              <span id="form-feedback" class="ev-feedback"></span>
            </div>
          </form>
        </div>
      </div>

      <!-- Event list -->
      <div id="event-list-wrap">
        <div id="event-list-loading" class="ea-loading">
          <div class="ea-loading-text">Loading events...</div>
        </div>
        <div id="event-list-empty" class="ea-empty hidden">
          <p>No events yet. Tap "+ NEW EVENT" to create one.</p>
        </div>
        <div id="event-list" class="ev-list hidden"></div>
      </div>
    </div>

    <!-- ═══ ANALYSIS TAB ═══ -->
    <div id="tab-analysis" class="ev-tab-content hidden">
    <div class="ea-header">
      <div class="ea-title-row">
        <h1 class="ea-title">Event Analysis</h1>
        <div class="ea-selector">
          <select id="event-select" class="ea-select">
            <option value="">Loading events...</option>
          </select>
        </div>
      </div>
    </div>

    <div id="loading" class="ea-loading">
      <div class="ea-loading-text">Loading...</div>
    </div>

    <div id="empty-state" class="ea-empty hidden">
      <p>No events found. Guest data will appear here after your first event.</p>
    </div>

    <div id="dashboard" class="ea-dashboard hidden">
      <!-- Summary Stats Row -->
      <div class="ea-stats-row">
        <div class="ea-stat-card">
          <div class="ea-stat-label">Total Guests</div>
          <div class="ea-stat-value" id="stat-total">--</div>
          <div class="ea-stat-sub">party size total</div>
        </div>
        <div class="ea-stat-card">
          <div class="ea-stat-label">Checked In</div>
          <div class="ea-stat-value" id="stat-checked">--</div>
          <div class="ea-stat-sub">actual arrivals</div>
        </div>
        <div class="ea-stat-card">
          <div class="ea-stat-label">Show Rate</div>
          <div class="ea-stat-value" id="stat-showrate">--</div>
          <div class="ea-stat-sub">checked in / total</div>
        </div>
        <div class="ea-stat-card">
          <div class="ea-stat-label">Walk-ins</div>
          <div class="ea-stat-value" id="stat-walkins">--</div>
          <div class="ea-stat-sub" id="stat-walkins-sub">of limit</div>
        </div>
        <div class="ea-stat-card">
          <div class="ea-stat-label">Revenue</div>
          <div class="ea-stat-value" id="stat-revenue">--</div>
          <div class="ea-stat-sub">estimated total</div>
        </div>
      </div>

      <!-- Two-column layout: chart + revenue -->
      <div class="ea-panels">
        <!-- Arrival Timeline -->
        <div class="ea-panel ea-panel-chart">
          <div class="ea-panel-header">
            <h2 class="ea-panel-title">Arrival Timeline</h2>
            <span class="ea-panel-badge" id="peak-badge"></span>
          </div>
          <div class="ea-chart-wrap" id="chart-wrap">
            <svg id="arrival-chart" class="ea-chart" viewBox="0 0 600 200" preserveAspectRatio="xMidYMid meet"></svg>
            <div id="chart-empty" class="ea-chart-empty hidden">No check-in data</div>
          </div>
        </div>

        <!-- Revenue Breakdown -->
        <div class="ea-panel ea-panel-revenue">
          <div class="ea-panel-header">
            <h2 class="ea-panel-title">Revenue Breakdown</h2>
          </div>
          <div id="revenue-table-wrap">
            <table class="ea-table ea-revenue-table">
              <thead>
                <tr>
                  <th>Tier</th>
                  <th class="num">Bookings</th>
                  <th class="num">Tickets</th>
                  <th class="num">Revenue</th>
                  <th class="num">Avg</th>
                </tr>
              </thead>
              <tbody id="revenue-body"></tbody>
              <tfoot>
                <tr class="ea-total-row">
                  <td>Total</td>
                  <td class="num" id="rev-total-bookings">--</td>
                  <td class="num" id="rev-total-tickets">--</td>
                  <td class="num" id="rev-total-revenue">--</td>
                  <td class="num">--</td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </div>

      <!-- Insights -->
      <div class="ea-panel ea-panel-insights">
        <div class="ea-panel-header">
          <h2 class="ea-panel-title">Insights</h2>
        </div>
        <div class="ea-insights" id="insights-list"></div>
      </div>

      <!-- Guest List Table -->
      <div class="ea-panel ea-panel-guests">
        <div class="ea-panel-header">
          <h2 class="ea-panel-title">Guest List</h2>
          <div class="ea-guest-controls">
            <input type="search" id="guest-search" class="ea-search" placeholder="Filter guests..." autocomplete="off" />
            <select id="guest-filter" class="ea-filter-select">
              <option value="all">All guests</option>
              <option value="checked-in">Checked in</option>
              <option value="no-show">No-shows</option>
              <option value="walk-in">Walk-ins</option>
            </select>
          </div>
        </div>
        <div class="ea-guest-table-wrap">
          <table class="ea-table ea-guest-table">
            <thead>
              <tr>
                <th class="sortable" data-col="name">Name</th>
                <th class="sortable" data-col="ticket_type">Ticket Type</th>
                <th class="sortable num" data-col="tickets">Party Size</th>
                <th class="sortable num" data-col="checked_in_count">Checked In</th>
                <th class="sortable" data-col="first_checked_in_at">Arrival Time</th>
              </tr>
            </thead>
            <tbody id="guest-body"></tbody>
          </table>
          <div id="guest-empty" class="ea-guest-empty hidden">No guests match filter</div>
        </div>
        <div class="ea-guest-footer">
          <span id="guest-count-label">0 guests</span>
        </div>
      </div>
    </div>
    </div><!-- /tab-analysis -->
  </div>
</AdminLayout>

<style is:global>
  /* ── Event Analysis & Management — Nothing design ── */

  .ea-root {
    padding: var(--sp-4) var(--sp-5) calc(var(--sp-4) * 3);
    max-width: 1400px;
    margin: 0 auto;
  }

  .ea-header {
    margin-bottom: var(--sp-5);
  }

  .ea-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }

  .ea-title {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 500;
    color: var(--text-display);
    margin: 0;
  }

  .ea-select {
    background: var(--surface);
    color: var(--text-primary);
    border: 1px solid var(--border-visible);
    border-radius: var(--radius-sm);
    padding: var(--sp-2) var(--sp-4);
    font-size: 13px;
    font-family: var(--font-mono);
    min-width: 180px;
    cursor: pointer;
    min-height: 44px;
  }

  .ea-select:focus {
    outline: none;
    border-color: var(--text-display);
  }

  .ea-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }

  .ea-loading-text {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.1em;
  }

  .ea-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .hidden { display: none !important; }

  /* ── Stats row ── */
  .ea-stats-row {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
  }

  .ea-stat-card {
    background: var(--surface);
    border-radius: var(--radius-lg);
    padding: var(--sp-4) var(--sp-4);
  }

  .ea-stat-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
    margin-bottom: var(--sp-1);
  }

  .ea-stat-value {
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 700;
    color: var(--text-display);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .ea-stat-sub {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-secondary);
    margin-top: var(--sp-1);
    letter-spacing: 0.04em;
  }

  /* ── Panels ── */
  .ea-panels {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
  }

  .ea-panel {
    background: var(--surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .ea-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--border);
    gap: var(--sp-2);
  }

  .ea-panel-title {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
    margin: 0;
  }

  .ea-panel-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    font-weight: 400;
    letter-spacing: 0.04em;
  }

  /* ── Chart ── */
  .ea-chart-wrap {
    padding: var(--sp-3) var(--sp-4);
    position: relative;
    min-height: 180px;
  }

  .ea-chart {
    width: 100%;
    height: auto;
  }

  .ea-chart-empty {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  /* ── Tables (shared) ── */
  .ea-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .ea-table th {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    padding: var(--sp-2) var(--sp-3);
    text-align: left;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
    user-select: none;
  }

  .ea-table th.num,
  .ea-table td.num {
    text-align: right;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .ea-table td {
    padding: var(--sp-2) var(--sp-3);
    border-bottom: 1px solid var(--border);
    color: var(--text-primary);
  }

  .ea-table tbody tr:hover {
    background: var(--surface-raised);
  }

  /* Revenue table */
  .ea-revenue-table {
    margin: 0;
  }

  .ea-total-row td {
    font-weight: 700;
    color: var(--text-display);
    border-top: 1px solid var(--border-visible);
    border-bottom: none;
  }

  /* ── Insights ── */
  .ea-panel-insights {
    margin-bottom: var(--sp-4);
  }

  .ea-insights {
    padding: var(--sp-3) var(--sp-4);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--sp-2);
  }

  .ea-insight {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-2);
    padding: var(--sp-2) var(--sp-3);
    background: var(--black);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 13px;
    color: var(--text-primary);
    line-height: 1.5;
  }

  .ea-insight-icon {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    margin-top: 2px;
    color: var(--text-secondary);
  }

  .ea-insight-value {
    color: var(--text-display);
    font-weight: 700;
    font-family: var(--font-mono);
  }

  /* ── Guest list ── */
  .ea-guest-controls {
    display: flex;
    gap: var(--sp-2);
    align-items: center;
  }

  .ea-search {
    background: transparent;
    color: var(--text-primary);
    border: none;
    border-bottom: 1px solid var(--border-visible);
    border-radius: 0;
    padding: var(--sp-1) 0;
    font-size: 13px;
    font-family: var(--font-mono);
    width: 160px;
    min-height: 36px;
  }

  .ea-search:focus {
    outline: none;
    border-bottom-color: var(--text-display);
  }

  .ea-search::placeholder {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .ea-filter-select {
    background: var(--surface);
    color: var(--text-primary);
    border: 1px solid var(--border-visible);
    border-radius: var(--radius-sm);
    padding: var(--sp-1) var(--sp-3);
    font-size: 12px;
    font-family: var(--font-mono);
    cursor: pointer;
    min-height: 36px;
  }

  .ea-filter-select:focus {
    outline: none;
    border-color: var(--text-display);
  }

  .ea-guest-table-wrap {
    overflow-x: auto;
    position: relative;
  }

  .ea-guest-table th.sortable {
    cursor: pointer;
  }

  .ea-guest-table th.sortable:hover {
    color: var(--text-primary);
  }

  .ea-guest-table th.sort-asc::after {
    content: ' B2';
    font-size: 8px;
  }

  .ea-guest-table th.sort-desc::after {
    content: ' BC';
    font-size: 8px;
  }

  .ea-guest-table .no-show td {
    color: var(--text-disabled);
  }

  .ea-guest-table .no-show td:first-child {
    border-left: 2px solid var(--accent);
  }

  .ea-guest-table .walkin-row td:first-child {
    border-left: 2px solid var(--border-visible);
  }

  .ea-guest-empty {
    padding: var(--sp-6);
    text-align: center;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .ea-guest-footer {
    padding: var(--sp-2) var(--sp-4);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-secondary);
    border-top: 1px solid var(--border);
    letter-spacing: 0.04em;
  }

  .ea-pill {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 400;
    padding: 2px 8px;
    border: 1px solid var(--border-visible);
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .ea-pill-walkin {
    color: var(--text-secondary);
    border-color: var(--border-visible);
  }

  /* ── Responsive (analysis) ── */
  @media (max-width: 900px) {
    .ea-stats-row {
      grid-template-columns: repeat(3, 1fr);
    }
    .ea-panels {
      grid-template-columns: 1fr;
    }
    .ea-insights {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .ea-stats-row {
      grid-template-columns: repeat(2, 1fr);
    }
    .ea-title-row {
      flex-direction: column;
      align-items: stretch;
    }
    .ea-guest-controls {
      flex-direction: column;
      align-items: stretch;
    }
    .ea-search {
      width: 100%;
    }
  }

  /* ═══ Event Management — Nothing design ═══ */

  /* Tab switcher */
  .ev-tabs {
    display: flex;
    gap: 0;
    margin-bottom: var(--sp-5);
    border-bottom: 1px solid var(--border);
  }

  .ev-tab {
    padding: var(--sp-3) var(--sp-5);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 400;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    -webkit-tap-highlight-color: transparent;
    min-height: 44px;
  }

  .ev-tab:hover {
    color: var(--text-primary);
  }

  .ev-tab.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .ev-tab-content.hidden {
    display: none !important;
  }

  /* Manage header */
  .ev-manage-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--sp-4);
    gap: var(--sp-3);
  }

  /* Buttons */
  .ev-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-2) var(--sp-5);
    background: var(--accent);
    color: var(--text-display);
    border: none;
    border-radius: var(--radius-sm);
    font-size: 12px;
    font-weight: 400;
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: opacity 0.15s;
    -webkit-tap-highlight-color: transparent;
    min-height: 44px;
  }

  .ev-btn-primary:hover {
    opacity: 0.85;
  }

  .ev-btn-primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ev-btn-cancel {
    padding: var(--sp-1) var(--sp-3);
    background: none;
    border: 1px solid var(--border-visible);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: 11px;
    font-weight: 400;
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    min-height: 44px;
  }

  .ev-btn-cancel:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Form */
  .ev-form-wrap {
    margin-bottom: var(--sp-4);
  }

  .ev-form {
    padding: var(--sp-4);
  }

  .ev-field {
    margin-bottom: var(--sp-4);
    flex: 1;
  }

  .ev-field-row {
    display: flex;
    gap: var(--sp-3);
  }

  .ev-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
    margin-bottom: var(--sp-1);
  }

  .ev-input {
    display: block;
    width: 100%;
    padding: var(--sp-2) var(--sp-3);
    background: transparent;
    color: var(--text-primary);
    border: none;
    border-bottom: 1px solid var(--border-visible);
    border-radius: 0;
    font-size: 14px;
    font-family: var(--font-body);
    transition: border-color 0.15s;
    min-height: 44px;
  }

  .ev-input:focus {
    outline: none;
    border-bottom-color: var(--text-display);
  }

  .ev-input::placeholder {
    color: var(--text-secondary);
  }

  .ev-hint {

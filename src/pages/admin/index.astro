---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { createClient } from '@supabase/supabase-js';

const supabase = createClient(
  import.meta.env.SUPABASE_URL,
  import.meta.env.SUPABASE_ANON_KEY
);

// Next event (first future event by date)
const today = new Date().toISOString().slice(0, 10);
const { data: nextEventRow } = await supabase
  .from('events')
  .select('name, date, slug')
  .gte('date', today)
  .order('date', { ascending: true })
  .limit(1)
  .maybeSingle();

const nextEventLabel = nextEventRow
  ? new Date(nextEventRow.date.slice(0, 10) + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' })
  : '—';
const nextEventSub = nextEventRow ? nextEventRow.name : 'No upcoming events';

// Total tickets sold (sum of guests.tickets across all events)
const { data: ticketRows } = await supabase
  .from('guests')
  .select('tickets');
const totalTickets = (ticketRows ?? []).reduce((sum, r) => sum + (r.tickets ?? 0), 0);

// Next event tickets + revenue (specific to the upcoming event)
let nextEventTickets = 0;
let nextEventRevenueCents = 0;
if (nextEventRow) {
  const { data: nextEventOrders } = await supabase
    .from('orders')
    .select('quantity, amount_cents')
    .eq('event', nextEventRow.slug)
    .neq('status', 'refunded');
  for (const o of (nextEventOrders ?? [])) {
    nextEventTickets += (o.quantity as number) ?? 0;
    nextEventRevenueCents += (o.amount_cents as number) ?? 0;
  }
}
const nextEventRevenueDisplay = nextEventRevenueCents > 0
  ? `$${(nextEventRevenueCents / 100).toLocaleString('en-US', { minimumFractionDigits: 0 })}`
  : '$0';

// Subscriber count
const { count: subscriberCount } = await supabase
  .from('subscribers')
  .select('*', { count: 'exact', head: true });

// Revenue: use orders if available, else estimate from guests × tier prices
// Exclude refunded orders from revenue and ticket counts
const { data: revenueRows } = await supabase
  .from('orders')
  .select('amount_cents, status')
  .neq('status', 'refunded');
let totalRevenueCents = (revenueRows ?? []).reduce((sum: number, r: Record<string, unknown>) => sum + ((r.amount_cents as number) ?? 0), 0);

// Fallback: estimate from guest ticket types when no order data
if (totalRevenueCents === 0 && (ticketRows ?? []).length > 0) {
  const TIER_PRICES: Record<string, number> = { 'Regular': 2000, 'Supporter': 3500, 'Walk-in': 2000 };
  const { data: guestTiers } = await supabase
    .from('guests')
    .select('ticket_type, tickets');
  totalRevenueCents = (guestTiers ?? []).reduce((sum: number, g: Record<string, unknown>) => {
    const price = TIER_PRICES[(g.ticket_type as string) ?? ''] ?? 0;
    return sum + ((g.tickets as number) ?? 0) * price;
  }, 0);
}

const revenueDisplay = totalRevenueCents > 0
  ? `$${(totalRevenueCents / 100).toLocaleString('en-US', { minimumFractionDigits: 0 })}`
  : '$0';

// Recent activity — merge ticket purchases and newsletter sign-ups
const { data: recentGuests } = await supabase
  .from('guests')
  .select('name, event, ticket_type, created_at, checked_in_count, first_checked_in_at')
  .order('created_at', { ascending: false })
  .limit(10);

const { data: recentSubs } = await supabase
  .from('subscribers')
  .select('email, subscribed_at')
  .order('subscribed_at', { ascending: false })
  .limit(10);

interface ActivityItem {
  label: string;
  detail: string;
  date: string;
}

const activityItems: ActivityItem[] = [];

for (const g of (recentGuests ?? [])) {
  const action = g.checked_in_count > 0 ? 'checked in' : 'purchased';
  activityItems.push({
    label: g.name,
    detail: `${action} · ${g.ticket_type ?? 'ticket'} · ${g.event}`,
    date: g.created_at,
  });
}

for (const s of (recentSubs ?? [])) {
  activityItems.push({
    label: s.email,
    detail: 'subscribed to newsletter',
    date: s.subscribed_at,
  });
}

// Sort combined feed by date descending, take 10
activityItems.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const recentActivity = activityItems.slice(0, 10);
---

<AdminLayout title="Dashboard — Blow Admin">
  <h1 class="page-title">Dashboard</h1>

  {nextEventRow && (
    <div class="dashboard-event-header">
      <span class="event-header-name">{nextEventSub}</span>
      <span class="event-header-date">{nextEventLabel}</span>
    </div>
  )}

  <div class="dashboard-stats">
    <div class="widget">
      <div class="widget-label">Tickets Sold</div>
      <div class="widget-value accent">{nextEventTickets}</div>
      <div class="widget-sub">{nextEventSub}</div>
    </div>
    <div class="widget">
      <div class="widget-label">Revenue</div>
      <div class="widget-value">{nextEventRevenueDisplay}</div>
      <div class="widget-sub">{nextEventSub}</div>
    </div>
    <div class="widget">
      <div class="widget-label">Subscribers</div>
      <div class="widget-value">{subscriberCount ?? 0}</div>
      <div class="widget-sub">total</div>
    </div>
    <div class="widget">
      <div class="widget-label">Lifetime Revenue</div>
      <div class="widget-value">{revenueDisplay}</div>
      <div class="widget-sub">{totalTickets} tickets · all events</div>
    </div>
  </div>

  <div class="dashboard-section">
    <h2 class="section-title">Recent Activity</h2>
    {recentActivity.length > 0 ? (
      <div class="activity-list">
        {recentActivity.map((item) => {
          const when = new Date(item.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
          return (
            <div class="activity-row">
              <span class="activity-name">{item.label}</span>
              <span class="activity-detail">{item.detail}</span>
              <span class="activity-time">{when}</span>
            </div>
          );
        })}
      </div>
    ) : (
      <div class="card dot-grid">
        <div class="dashboard-empty state-empty">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
            <rect x="6" y="10" width="36" height="28" rx="2" stroke="currentColor" stroke-width="1.5"/>
            <path d="M6 18h36M18 18v20" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          <p>No recent activity to display.</p>
        </div>
      </div>
    )}
  </div>
</AdminLayout>

<style>
  .dashboard-event-header {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--border);
  }

  .event-header-name {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 500;
    color: var(--text-display);
  }

  .event-header-date {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
    letter-spacing: 0.04em;
  }

  .dashboard-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-4);
    margin-bottom: var(--sp-8);
  }

  @media (min-width: 601px) {
    .dashboard-stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .dashboard-section {
    margin-bottom: var(--sp-8);
  }

  .dashboard-empty {
    min-height: 200px;
    padding: var(--sp-12) var(--sp-6);
  }

  .activity-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .activity-row {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--border);
  }

  .activity-row:last-child {
    border-bottom: none;
  }

  .activity-name {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-primary);
    white-space: nowrap;
  }

  .activity-detail {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .activity-time {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-secondary);
    white-space: nowrap;
  }
</style>

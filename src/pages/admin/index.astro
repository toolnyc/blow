---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard — Blow Admin">
  <h1 class="admin-page-title">Dashboard</h1>

  <div class="dashboard-stats">
    <div class="admin-card">
      <div class="admin-card-label">Next Event</div>
      <div class="admin-card-value">--</div>
    </div>
    <div class="admin-card">
      <div class="admin-card-label">Tickets Sold</div>
      <div class="admin-card-value accent">--</div>
    </div>
    <div class="admin-card">
      <div class="admin-card-label">Subscribers</div>
      <div class="admin-card-value">--</div>
    </div>
    <div class="admin-card">
      <div class="admin-card-label">Revenue</div>
      <div class="admin-card-value">--</div>
    </div>
  </div>

  <div class="dashboard-section">
    <h2 class="dashboard-section-title">Recent Activity</h2>
    <div class="admin-card">
      <p class="dashboard-empty">No recent activity to display.</p>
    </div>
  </div>
</AdminLayout>

<style>
  .dashboard-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  @media (min-width: 601px) {
    .dashboard-stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .dashboard-section {
    margin-bottom: var(--space-xl);
  }

  .dashboard-section-title {
    font-size: var(--font-size-lg);
    color: var(--admin-text);
    margin-bottom: var(--space-md);
  }

  .dashboard-empty {
    color: var(--admin-text-muted);
    font-size: var(--font-size-base);
    padding: var(--space-lg) 0;
    text-align: center;
  }
</style>

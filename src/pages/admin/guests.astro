---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Guests — Blow Admin">
  <div class="gu-root">
    <div class="gu-header">
      <h1 class="gu-title">Guests</h1>
      <div class="gu-controls">
        <input type="search" id="guest-search" class="gu-search" placeholder="Search name or email..." autocomplete="off" />
        <select id="event-filter" class="gu-select">
          <option value="">All events</option>
        </select>
        <select id="type-filter" class="gu-select">
          <option value="">All types</option>
          <option value="Regular">Regular</option>
          <option value="Supporter">Supporter</option>
          <option value="Walk-in">Walk-in</option>
        </select>
      </div>
    </div>

    <div id="loading" class="ea-loading">
      <div class="ea-loading-text">Loading guests...</div>
    </div>

    <div id="empty-state" class="ea-empty hidden">
      <p>No guests found.</p>
    </div>

    <div id="guest-panel" class="ea-panel hidden">
      <div class="gu-table-wrap">
        <table class="ea-table gu-table">
          <thead>
            <tr>
              <th class="sortable" data-col="name">Name</th>
              <th class="sortable" data-col="email">Email</th>
              <th class="sortable" data-col="event">Event</th>
              <th class="sortable" data-col="ticket_type">Type</th>
              <th class="sortable num" data-col="tickets">Tickets</th>
              <th class="sortable num" data-col="checked_in_count">Checked In</th>
              <th class="sortable num" data-col="event_count">Visits</th>
            </tr>
          </thead>
          <tbody id="guest-body"></tbody>
        </table>
        <div id="no-match" class="gu-no-match hidden">No guests match filters</div>
      </div>
      <div class="gu-footer">
        <span id="guest-count">0 guests</span>
      </div>
    </div>
  </div>
</AdminLayout>

<style is:global>
  .gu-root {
    padding: var(--sp-4) var(--sp-5) calc(var(--sp-4) * 3);
    max-width: 1400px;
    margin: 0 auto;
  }

  .gu-header {
    margin-bottom: var(--sp-4);
  }

  .gu-title {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 500;
    color: var(--text-display);
    margin: 0 0 var(--sp-3);
  }

  .gu-controls {
    display: flex;
    gap: var(--sp-2);
    flex-wrap: wrap;
    align-items: center;
  }

  .gu-search {
    background: transparent;
    color: var(--text-primary);
    border: none;
    border-bottom: 1px solid var(--border-visible);
    border-radius: 0;
    padding: var(--sp-1) 0;
    font-size: 13px;
    font-family: var(--font-mono);
    flex: 1;
    min-width: 180px;
    min-height: 36px;
  }

  .gu-search:focus {
    outline: none;
    border-bottom-color: var(--text-display);
  }

  .gu-search::placeholder {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .gu-select {
    background: var(--surface);
    color: var(--text-primary);
    border: 1px solid var(--border-visible);
    border-radius: var(--radius-sm);
    padding: var(--sp-1) var(--sp-3);
    font-size: 12px;
    font-family: var(--font-mono);
    cursor: pointer;
    min-height: 36px;
  }

  .gu-select:focus {
    outline: none;
    border-color: var(--text-display);
  }

  .gu-table-wrap {
    overflow-x: auto;
  }

  .gu-table th.sortable {
    cursor: pointer;
  }

  .gu-table th.sortable:hover {
    color: var(--text-primary);
  }

  .gu-table th.sort-asc::after {
    content: ' ▲';
    font-size: 8px;
  }

  .gu-table th.sort-desc::after {
    content: ' ▼';
    font-size: 8px;
  }

  .gu-table .repeat-guest td:first-child {
    border-left: 2px solid var(--accent);
  }

  .gu-visits-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 1px 6px;
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .gu-visits-badge.repeat {
    background: rgba(255, 40, 69, 0.15);
    color: var(--accent);
  }

  .gu-no-match {
    padding: var(--sp-6);
    text-align: center;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .gu-footer {
    padding: var(--sp-2) var(--sp-4);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-secondary);
    border-top: 1px solid var(--border);
    letter-spacing: 0.04em;
  }

  @media (max-width: 600px) {
    .gu-controls {
      flex-direction: column;
      align-items: stretch;
    }
    .gu-search {
      width: 100%;
    }
  }
</style>

<script>
  interface Guest {
    id: string;
    event: string;
    name: string;
    email: string | null;
    ticket_type: string;
    tickets: number;
    checked_in_count: number;
    first_checked_in_at: string | null;
    created_at: string;
    event_count: number;
  }

  let allGuests: Guest[] = [];
  let sortCol = 'name';
  let sortDir: 'asc' | 'desc' = 'asc';

  const loading = document.getElementById('loading') as HTMLDivElement;
  const emptyState = document.getElementById('empty-state') as HTMLDivElement;
  const guestPanel = document.getElementById('guest-panel') as HTMLDivElement;
  const tbody = document.getElementById('guest-body') as HTMLTableSectionElement;
  const noMatch = document.getElementById('no-match') as HTMLDivElement;
  const countLabel = document.getElementById('guest-count') as HTMLSpanElement;
  const searchInput = document.getElementById('guest-search') as HTMLInputElement;
  const eventFilter = document.getElementById('event-filter') as HTMLSelectElement;
  const typeFilter = document.getElementById('type-filter') as HTMLSelectElement;

  async function init() {
    try {
      const res = await fetch('/api/guests');
      if (!res.ok) throw new Error('Failed');
      const data = await res.json();
      allGuests = data.guests as Guest[];

      // Populate event filter
      for (const ev of data.events as Array<{ slug: string; name: string }>) {
        const opt = document.createElement('option');
        opt.value = ev.slug;
        opt.textContent = ev.name;
        eventFilter.appendChild(opt);
      }

      if (allGuests.length === 0) {
        loading.classList.add('hidden');
        emptyState.classList.remove('hidden');
        return;
      }

      loading.classList.add('hidden');
      guestPanel.classList.remove('hidden');
      renderGuests();
    } catch {
      loading.classList.add('hidden');
      emptyState.classList.remove('hidden');
      const p = emptyState.querySelector('p');
      if (p) p.textContent = 'Failed to load guests. Are you logged in?';
    }
  }

  function renderGuests() {
    tbody.innerHTML = '';

    const search = searchInput.value.toLowerCase().trim();
    const evFilter = eventFilter.value;
    const tFilter = typeFilter.value;

    let filtered = allGuests.slice();

    if (evFilter) {
      filtered = filtered.filter(g => g.event === evFilter);
    }
    if (tFilter) {
      filtered = filtered.filter(g => g.ticket_type === tFilter);
    }
    if (search) {
      filtered = filtered.filter(g =>
        g.name.toLowerCase().includes(search) ||
        (g.email ?? '').toLowerCase().includes(search)
      );
    }

    // Sort
    filtered.sort((a, b) => {
      let aVal: unknown = (a as Record<string, unknown>)[sortCol];
      let bVal: unknown = (b as Record<string, unknown>)[sortCol];

      if (typeof aVal === 'number' && typeof bVal === 'number') {
        return sortDir === 'asc' ? aVal - bVal : bVal - aVal;
      }
      const aStr = String(aVal ?? '').toLowerCase();
      const bStr = String(bVal ?? '').toLowerCase();
      const cmp = aStr.localeCompare(bStr);
      return sortDir === 'asc' ? cmp : -cmp;
    });

    if (filtered.length === 0) {
      noMatch.classList.remove('hidden');
    } else {
      noMatch.classList.add('hidden');
    }

    for (const g of filtered) {
      const isRepeat = g.event_count > 1;
      const tr = document.createElement('tr');
      if (isRepeat) tr.className = 'repeat-guest';

      const visitsBadge = isRepeat
        ? `<span class="gu-visits-badge repeat">${g.event_count}</span>`
        : `<span class="gu-visits-badge">1</span>`;

      tr.innerHTML = `
        <td>${esc(g.name)}</td>
        <td>${esc(g.email ?? '—')}</td>
        <td>${esc(g.event)}</td>
        <td>${esc(g.ticket_type)}</td>
        <td class="num">${g.tickets}</td>
        <td class="num">${g.checked_in_count}/${g.tickets}</td>
        <td class="num">${visitsBadge}</td>
      `;
      tbody.appendChild(tr);
    }

    countLabel.textContent = `${filtered.length} guest${filtered.length !== 1 ? 's' : ''}`;

    // Sort indicators
    document.querySelectorAll('.gu-table th.sortable').forEach(th => {
      th.classList.remove('sort-asc', 'sort-desc');
      if ((th as HTMLElement).dataset.col === sortCol) {
        th.classList.add(sortDir === 'asc' ? 'sort-asc' : 'sort-desc');
      }
    });
  }

  // Sorting
  document.querySelectorAll('.gu-table th.sortable').forEach(th => {
    th.addEventListener('click', () => {
      const col = (th as HTMLElement).dataset.col ?? 'name';
      if (sortCol === col) {
        sortDir = sortDir === 'asc' ? 'desc' : 'asc';
      } else {
        sortCol = col;
        sortDir = 'asc';
      }
      renderGuests();
    });
  });

  // Filters
  searchInput.addEventListener('input', () => renderGuests());
  eventFilter.addEventListener('change', () => renderGuests());
  typeFilter.addEventListener('change', () => renderGuests());

  function esc(str: string): string {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  init();
</script>

---
import Layout from '../layouts/Layout.astro';
import Window from '../components/Window.astro';
import Taskbar from '../components/Taskbar.astro';
---

<Layout title="BlowNet — Early Access">
  <Window
    title="Early Access"
    icon="/icons/events.svg"
    statusText="Ready"
    id="ea-window"
  >
    <img src="/wordmark.svg" alt="Blow" class="wordmark" />
    <p id="ea-status" class="hint">Validating code...</p>
    <div id="ea-event-info" style="display:none; text-align:center;">
      <p id="ea-event-name" style="font-weight:bold; margin: 0;"></p>
      <p id="ea-event-date" class="hint" style="margin: 4px 0 0 0;"></p>
    </div>
    <div class="ticket-buttons" id="ea-tiers"></div>
    <p id="ea-error" style="display:none; color: #ff2845; text-align:center;"></p>
  </Window>

  <Taskbar menuItems={[{ id: 'ea-window', title: 'Early Access', icon: '/icons/events.svg' }]} />
</Layout>

<style>
  :global(.desktop) {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 80px;
  }

  .wordmark {
    width: 180px;
    height: auto;
    margin-bottom: 8px;
  }

  .hint {
    color: #808080;
    font-size: 12px;
    margin: 4px 0;
  }

  .ticket-buttons {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: stretch;
    margin-top: 16px;
  }

  .error-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 200;
  }

  .dialog {
    min-width: 300px;
    max-width: 400px;
  }
</style>

<style is:global>
  .tier-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .tier-label {
    font-size: 12px;
    font-weight: bold;
    white-space: nowrap;
  }

  .tier-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .qty-controls {
    display: flex;
    align-items: center;
    gap: 0;
    border: 2px solid #888;
    background: #fff;
    flex-shrink: 0;
  }

  .qty-btn {
    width: 24px;
    height: 22px;
    font-size: 14px;
    font-weight: bold;
    padding: 0;
    border: none;
    background: #c0c0c0;
    cursor: pointer;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .qty-btn:hover:not(:disabled) {
    background: #d4d4d4;
  }

  .qty-btn:disabled {
    color: #aaa;
    cursor: default;
  }

  .qty-display {
    width: 28px;
    text-align: center;
    font-size: 13px;
    font-weight: bold;
    font-family: monospace;
    background: #fff;
    line-height: 22px;
  }

  .buy-btn {
    min-width: 50px;
    font-weight: bold;
    font-size: 12px;
    flex-shrink: 0;
  }
</style>

<!-- Error dialog -->
<div id="error-dialog" class="error-overlay" style="display: none;">
  <div class="window dialog">
    <div class="title-bar">
      <div class="title-bar-text">Error</div>
      <div class="title-bar-controls">
        <button aria-label="Close" id="error-close"></button>
      </div>
    </div>
    <div class="window-body" style="padding: 16px; text-align: center;">
      <p id="error-message">Something went wrong.</p>
      <button id="error-ok-btn" style="margin-top: 8px;">OK</button>
    </div>
  </div>
</div>

<script>
  const statusEl = document.getElementById('ea-status')!;
  const eventInfo = document.getElementById('ea-event-info')!;
  const eventName = document.getElementById('ea-event-name')!;
  const eventDate = document.getElementById('ea-event-date')!;
  const tiersEl = document.getElementById('ea-tiers')!;
  const errorEl = document.getElementById('ea-error')!;
  const errorDialog = document.getElementById('error-dialog')!;
  const errorMessage = document.getElementById('error-message')!;
  const errorClose = document.getElementById('error-close')!;
  const errorOkBtn = document.getElementById('error-ok-btn')!;

  errorClose.addEventListener('click', () => { errorDialog.style.display = 'none'; });
  errorOkBtn.addEventListener('click', () => { errorDialog.style.display = 'none'; });

  const params = new URLSearchParams(window.location.search);
  const code = params.get('code');

  let currentEventSlug = '';

  async function init() {
    if (!code) {
      showError('No access code provided. Check your link.');
      return;
    }

    try {
      const res = await fetch(`/api/early-access-validate?code=${encodeURIComponent(code)}`);
      const data = await res.json();

      if (!data.valid) {
        showError(data.error || 'Invalid access code.');
        return;
      }

      currentEventSlug = data.event.slug;
      statusEl.style.display = 'none';

      // Show event info
      eventInfo.style.display = 'block';
      eventName.textContent = data.event.name;
      if (data.event.date) {
        const d = new Date(data.event.date);
        eventDate.textContent = d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
      }

      // Show tier buttons
      if (data.tiers.length === 0) {
        showError('No tickets available for this code.');
        return;
      }

      tiersEl.innerHTML = '';
      for (const tier of data.tiers) {
        const maxQty = tier.max_per_order ?? 4;
        const dollars = (tier.price_cents / 100).toFixed(0);

        const row = document.createElement('div');
        row.className = 'tier-row';

        const label = document.createElement('span');
        label.className = 'tier-label';
        label.textContent = `${tier.name} — $${dollars}`;
        row.appendChild(label);

        const bottom = document.createElement('div');
        bottom.className = 'tier-controls';

        let qty = 1;

        if (maxQty > 1) {
          const controls = document.createElement('div');
          controls.className = 'qty-controls';

          const minusBtn = document.createElement('button');
          minusBtn.className = 'qty-btn';
          minusBtn.textContent = '−';
          minusBtn.disabled = true;

          const qtySpan = document.createElement('span');
          qtySpan.className = 'qty-display';
          qtySpan.textContent = '1';

          const plusBtn = document.createElement('button');
          plusBtn.className = 'qty-btn';
          plusBtn.textContent = '+';

          minusBtn.addEventListener('click', () => {
            if (qty > 1) { qty--; qtySpan.textContent = String(qty); }
            minusBtn.disabled = qty <= 1;
            plusBtn.disabled = qty >= maxQty;
          });

          plusBtn.addEventListener('click', () => {
            if (qty < maxQty) { qty++; qtySpan.textContent = String(qty); }
            minusBtn.disabled = qty <= 1;
            plusBtn.disabled = qty >= maxQty;
          });

          controls.appendChild(minusBtn);
          controls.appendChild(qtySpan);
          controls.appendChild(plusBtn);
          bottom.appendChild(controls);
        }

        const buyBtn = document.createElement('button');
        buyBtn.className = 'buy-btn';
        buyBtn.dataset.tier = tier.name;
        buyBtn.textContent = 'Buy';
        buyBtn.addEventListener('click', () => handleCheckout(buyBtn, () => qty));
        bottom.appendChild(buyBtn);
        row.appendChild(bottom);

        tiersEl.appendChild(row);
      }
    } catch {
      showError('Could not validate access code. Try again.');
    }
  }

  function showError(msg: string) {
    statusEl.style.display = 'none';
    errorEl.style.display = 'block';
    errorEl.textContent = msg;
  }

  async function handleCheckout(button: HTMLButtonElement, getQty?: () => number) {
    const tier = button.dataset.tier;
    if (!tier || !currentEventSlug) return;

    const quantity = getQty ? getQty() : 1;
    const label = button.textContent;
    button.disabled = true;
    button.textContent = '...';

    try {
      const response = await fetch('/api/create-checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tier, quantity, event: currentEventSlug, access_code: code }),
      });

      const data = await response.json();

      if (response.ok && data.url) {
        window.location.href = data.url;
      } else {
        errorMessage.textContent = data.error || 'Could not start checkout.';
        errorDialog.style.display = 'flex';
        button.disabled = false;
        button.textContent = label;
      }
    } catch {
      errorMessage.textContent = 'Network error. Please try again.';
      errorDialog.style.display = 'flex';
      button.disabled = false;
      button.textContent = label;
    }
  }

  init();
</script>

---
import { createClient } from '@supabase/supabase-js';

export const prerender = false;

const { event } = Astro.params;
if (!event) return Astro.redirect('/');

const supabase = createClient(
  import.meta.env.SUPABASE_URL,
  import.meta.env.SUPABASE_ANON_KEY
);

const { data: guests, error } = await supabase
  .from('guests')
  .select('*')
  .eq('event', event)
  .order('name');

if (error || !guests) {
  return new Response('Could not load guest list', { status: 500 });
}

const totalPeople = guests.reduce((s, g) => s + (g.tickets as number), 0);
const checkedInPeople = guests.reduce((s, g) => s + (g.checked_in_count as number), 0);

function rowClass(checked: number, total: number) {
  if (checked === 0) return '';
  if (checked >= total) return ' full';
  return ' partial';
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <title>Blow — Door</title>
  </head>
  <body>
    <div id="header">
      <div class="header-top">
        <img src="/wordmark.svg" class="logo" alt="Blow" />
        <span id="stats">
          <span id="stats-in">{checkedInPeople}</span> / {totalPeople} people in
        </span>
      </div>
      <div class="search-row">
        <input
          type="search"
          id="search"
          placeholder="Search guests…"
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
        />
        <button id="add-toggle">+ Add</button>
      </div>
      <div id="add-form" class="add-form hidden">
        <input
          type="text"
          id="add-name"
          placeholder="Guest name"
          autocomplete="off"
          autocorrect="off"
        />
        <button id="add-submit">Add</button>
        <button id="add-cancel" class="btn-cancel">Cancel</button>
      </div>
    </div>

    <div id="guest-list">
      {guests.map((g) => {
        const checked = g.checked_in_count as number;
        const total = g.tickets as number;
        const id = g.id as string;
        return (
          <div
            class={`guest${rowClass(checked, total)}`}
            id={`g-${id}`}
            data-id={id}
            data-checked={checked}
            data-tickets={total}
            data-name={(g.name as string).toLowerCase()}
          >
            <div class="info">
              <div class="name">{g.name}</div>
              {(total > 1 || g.notes) && (
                <div class="meta">
                  {total > 1 && <span class="party-size">Party of {total}</span>}
                  {g.notes && <span class="notes">{g.notes}</span>}
                </div>
              )}
            </div>
            <div class="actions" id={`actions-${id}`}>
              {checked === 0 && (
                <button class="btn-in" data-action="in" data-id={id}>Check In</button>
              )}
              {checked > 0 && checked < total && (
                <>
                  <span class="badge partial">{checked}/{total}</span>
                  <button class="btn-in small" data-action="in" data-id={id}>+</button>
                  <button class="btn-undo" data-action="undo" data-id={id}>−</button>
                </>
              )}
              {checked >= total && total > 0 && (
                <>
                  <span class="badge full">✓{total > 1 ? ` ${total}/${total}` : ''}</span>
                  <button class="btn-undo" data-action="undo" data-id={id}>−</button>
                </>
              )}
            </div>
          </div>
        );
      })}
      <div id="no-results">No guests found</div>
    </div>

    <script define:vars={{ initCheckedIn: checkedInPeople, totalPeople, currentEvent: event }}>
      let peopleIn = initCheckedIn;
      const statsEl = document.getElementById('stats-in');

      // Search
      const searchEl = document.getElementById('search');
      const noResults = document.getElementById('no-results');

      function getRows() {
        return document.querySelectorAll('.guest');
      }

      searchEl.addEventListener('input', () => {
        const q = searchEl.value.toLowerCase().trim();
        let visible = 0;
        getRows().forEach(row => {
          const match = !q || (row.dataset.name || '').includes(q);
          row.classList.toggle('hidden', !match);
          if (match) visible++;
        });
        noResults.style.display = visible === 0 ? 'block' : 'none';
      });

      // Add guest form toggle
      const addToggle = document.getElementById('add-toggle');
      const addForm = document.getElementById('add-form');
      const addName = document.getElementById('add-name');
      const addSubmit = document.getElementById('add-submit');
      const addCancel = document.getElementById('add-cancel');

      addToggle.addEventListener('click', () => {
        addForm.classList.toggle('hidden');
        if (!addForm.classList.contains('hidden')) addName.focus();
      });

      addCancel.addEventListener('click', () => {
        addForm.classList.add('hidden');
        addName.value = '';
      });

      addSubmit.addEventListener('click', () => submitAddGuest());
      addName.addEventListener('keydown', (e) => { if (e.key === 'Enter') submitAddGuest(); });

      async function submitAddGuest() {
        const name = addName.value.trim();
        if (!name) { addName.focus(); return; }

        addSubmit.disabled = true;
        addSubmit.textContent = '…';

        try {
          const res = await fetch('/api/add-guest', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ event: currentEvent, name }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error);

          const g = data.guest;
          const div = document.createElement('div');
          div.className = 'guest new-guest';
          div.id = `g-${g.id}`;
          div.dataset.id = g.id;
          div.dataset.checked = '0';
          div.dataset.tickets = '1';
          div.dataset.name = g.name.toLowerCase();
          div.innerHTML =
            `<div class="info"><div class="name">${esc(g.name)}</div></div>` +
            `<div class="actions" id="actions-${g.id}">` +
            `<button class="btn-in" data-action="in" data-id="${g.id}">Check In</button>` +
            `</div>`;

          const list = document.getElementById('guest-list');
          list.insertBefore(div, list.firstChild);

          addName.value = '';
          addForm.classList.add('hidden');
        } catch (err) {
          alert('Could not add guest: ' + err.message);
        } finally {
          addSubmit.disabled = false;
          addSubmit.textContent = 'Add';
        }
      }

      function esc(str) {
        return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }

      // Check-in via event delegation
      document.getElementById('guest-list').addEventListener('click', async (e) => {
        const btn = e.target.closest('[data-action]');
        if (!btn) return;

        const action = btn.dataset.action;
        const id = btn.dataset.id;
        const row = document.getElementById(`g-${id}`);
        if (!row) return;

        row.querySelectorAll('button').forEach(b => (b.disabled = true));

        const checked = parseInt(row.dataset.checked, 10);
        const tickets = parseInt(row.dataset.tickets, 10);

        const newChecked = action === 'in'
          ? Math.min(checked + 1, tickets)
          : Math.max(checked - 1, 0);

        applyRow(row, id, newChecked, tickets);
        statsEl.textContent = action === 'in' ? peopleIn + 1 : Math.max(peopleIn - 1, 0);

        try {
          const res = await fetch('/api/checkin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, action }),
          });
          if (!res.ok) throw new Error('failed');
          peopleIn = action === 'in' ? peopleIn + 1 : Math.max(peopleIn - 1, 0);
          statsEl.textContent = peopleIn;
        } catch {
          applyRow(row, id, checked, tickets);
          statsEl.textContent = peopleIn;
        }
      });

      function applyRow(row, id, checked, tickets) {
        row.dataset.checked = checked;
        row.classList.remove('partial', 'full');
        if (checked > 0 && checked < tickets) row.classList.add('partial');
        else if (checked >= tickets && tickets > 0) row.classList.add('full');

        const el = document.getElementById(`actions-${id}`);
        if (!el) return;

        if (checked === 0) {
          el.innerHTML = `<button class="btn-in" data-action="in" data-id="${id}">Check In</button>`;
        } else if (checked < tickets) {
          el.innerHTML =
            `<span class="badge partial">${checked}/${tickets}</span>` +
            `<button class="btn-in small" data-action="in" data-id="${id}">+</button>` +
            `<button class="btn-undo" data-action="undo" data-id="${id}">−</button>`;
        } else {
          el.innerHTML =
            `<span class="badge full">✓${tickets > 1 ? ` ${tickets}/${tickets}` : ''}</span>` +
            `<button class="btn-undo" data-action="undo" data-id="${id}">−</button>`;
        }
      }
    </script>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: #f0f0f0;
    color: #111;
  }

  #header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: #111;
    padding: 12px 16px 10px;
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }

  .logo {
    height: 26px;
    width: auto;
  }

  #stats {
    font-size: 13px;
    color: #888;
  }

  #stats-in {
    color: white;
    font-weight: 700;
  }

  .search-row {
    display: flex;
    gap: 8px;
  }

  #search {
    flex: 1;
    padding: 9px 12px;
    border: none;
    border-radius: 8px;
    background: #2a2a2a;
    color: white;
    font-size: 16px;
    outline: none;
  }

  #search::placeholder { color: #555; }

  #add-toggle {
    padding: 0 14px;
    background: #2a2a2a;
    color: #aaa;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    min-height: 40px;
  }

  #add-toggle:active { background: #3a3a3a; }

  .add-form {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }

  .add-form.hidden { display: none; }

  #add-name {
    flex: 1;
    padding: 9px 12px;
    border: none;
    border-radius: 8px;
    background: #2a2a2a;
    color: white;
    font-size: 16px;
    outline: none;
  }

  #add-name::placeholder { color: #555; }

  #add-submit {
    padding: 0 16px;
    background: #ff2845;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    min-height: 40px;
  }

  #add-submit:active { background: #cc1f37; }

  .btn-cancel {
    padding: 0 14px;
    background: #2a2a2a;
    color: #aaa;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    cursor: pointer;
    min-height: 40px;
  }

  #guest-list { padding: 6px 0; }

  .guest {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 16px;
    background: white;
    border-bottom: 1px solid #e8e8e8;
    min-height: 62px;
  }

  .guest.partial { background: #fff8e1; }
  .guest.full    { background: #e8f5e9; }
  .guest.hidden  { display: none; }

  .guest.new-guest {
    border-left: 3px solid #ff2845;
  }

  .info {
    flex: 1;
    min-width: 0;
    padding-right: 12px;
  }

  .name {
    font-size: 16px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 3px;
    align-items: baseline;
  }

  .party-size {
    font-size: 12px;
    font-weight: 700;
    background: #e8e8e8;
    color: #444;
    padding: 1px 7px;
    border-radius: 10px;
  }

  .notes {
    font-size: 11px;
    color: #aaa;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  button {
    cursor: pointer;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 700;
    min-height: 42px;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .btn-in {
    background: #ff2845;
    color: white;
    padding: 0 16px;
  }

  .btn-in:active { background: #cc1f37; }

  .btn-in.small {
    font-size: 20px;
    padding: 0 13px;
  }

  .btn-undo {
    background: #e0e0e0;
    color: #444;
    font-size: 20px;
    padding: 0 13px;
  }

  .btn-undo:active { background: #ccc; }

  button:disabled { opacity: 0.4; }

  .badge {
    font-size: 13px;
    font-weight: 700;
    padding: 4px 9px;
    border-radius: 5px;
    white-space: nowrap;
  }

  .badge.partial { background: #ffca28; color: #333; }
  .badge.full    { background: #43a047; color: white; }

  #no-results {
    display: none;
    text-align: center;
    padding: 48px 16px;
    color: #999;
    font-size: 15px;
  }
</style>

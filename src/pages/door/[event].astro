---
import { createClient } from '@supabase/supabase-js';

export const prerender = false;

const { event } = Astro.params;
if (!event) return Astro.redirect('/');

const supabase = createClient(
  import.meta.env.SUPABASE_URL,
  import.meta.env.SUPABASE_ANON_KEY
);

const { data: guests, error } = await supabase
  .from('guests')
  .select('*')
  .eq('event', event)
  .order('name');

if (error || !guests) {
  return new Response('Could not load guest list', { status: 500 });
}

const totalTickets = guests.reduce((sum, g) => sum + (g.tickets as number), 0);
const checkedInTickets = guests.reduce((sum, g) => sum + (g.checked_in_count as number), 0);

function rowClass(checked: number, total: number) {
  if (checked === 0) return '';
  if (checked >= total) return ' full';
  return ' partial';
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <title>Blow — Door</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: #f0f0f0;
        color: #111;
      }

      #header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: #111;
        color: white;
        padding: 12px 16px 10px;
      }

      .header-top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 10px;
      }

      .brand {
        font-size: 22px;
        font-weight: 900;
        letter-spacing: 0.08em;
        color: #ff2845;
      }

      #stats {
        font-size: 13px;
        color: #888;
      }

      #stats-in {
        color: white;
        font-weight: 700;
      }

      #search {
        width: 100%;
        padding: 9px 12px;
        border: none;
        border-radius: 8px;
        background: #2a2a2a;
        color: white;
        font-size: 16px;
        outline: none;
      }

      #search::placeholder { color: #555; }

      #guest-list { padding: 6px 0; }

      .guest {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 11px 16px;
        background: white;
        border-bottom: 1px solid #e8e8e8;
        min-height: 62px;
      }

      .guest.partial { background: #fff8e1; }
      .guest.full    { background: #e8f5e9; }
      .guest.hidden  { display: none; }

      .info {
        flex: 1;
        min-width: 0;
        padding-right: 12px;
      }

      .name {
        font-size: 16px;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .meta {
        font-size: 12px;
        color: #777;
        margin-top: 2px;
      }

      .ticket-count {
        font-weight: 700;
        margin-left: 3px;
      }

      .notes {
        font-size: 11px;
        color: #aaa;
        margin-top: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
      }

      button {
        cursor: pointer;
        border: none;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 700;
        min-height: 42px;
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
      }

      .btn-in {
        background: #ff2845;
        color: white;
        padding: 0 16px;
      }

      .btn-in:active { background: #cc1f37; }

      .btn-in.small {
        font-size: 20px;
        padding: 0 13px;
      }

      .btn-undo {
        background: #e0e0e0;
        color: #444;
        font-size: 20px;
        padding: 0 13px;
      }

      .btn-undo:active { background: #ccc; }

      button:disabled { opacity: 0.4; }

      .badge {
        font-size: 13px;
        font-weight: 700;
        padding: 4px 9px;
        border-radius: 5px;
        white-space: nowrap;
      }

      .badge.partial { background: #ffca28; color: #333; }
      .badge.full    { background: #43a047; color: white; }

      #no-results {
        display: none;
        text-align: center;
        padding: 48px 16px;
        color: #999;
        font-size: 15px;
      }
    </style>
  </head>
  <body>
    <div id="header">
      <div class="header-top">
        <span class="brand">BLOW</span>
        <span id="stats">
          <span id="stats-in">{checkedInTickets}</span> / {totalTickets} tickets in
        </span>
      </div>
      <input
        type="search"
        id="search"
        placeholder="Search guests…"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
      />
    </div>

    <div id="guest-list">
      {guests.map((g) => {
        const checked = g.checked_in_count as number;
        const total = g.tickets as number;
        const id = g.id as string;
        return (
          <div
            class={`guest${rowClass(checked, total)}`}
            id={`g-${id}`}
            data-id={id}
            data-checked={checked}
            data-tickets={total}
            data-name={(g.name as string).toLowerCase()}
          >
            <div class="info">
              <div class="name">{g.name}</div>
              <div class="meta">
                {g.ticket_type}{total > 1 && <span class="ticket-count">×{total}</span>}
              </div>
              {g.notes && <div class="notes">{g.notes}</div>}
            </div>
            <div class="actions" id={`actions-${id}`}>
              {checked === 0 && (
                <button class="btn-in" data-action="in" data-id={id}>Check In</button>
              )}
              {checked > 0 && checked < total && (
                <>
                  <span class="badge partial">{checked}/{total}</span>
                  <button class="btn-in small" data-action="in" data-id={id}>+</button>
                  <button class="btn-undo" data-action="undo" data-id={id}>−</button>
                </>
              )}
              {checked >= total && total > 0 && (
                <>
                  <span class="badge full">✓{total > 1 ? ` ${total}/${total}` : ''}</span>
                  <button class="btn-undo" data-action="undo" data-id={id}>−</button>
                </>
              )}
            </div>
          </div>
        );
      })}
      <div id="no-results">No guests found</div>
    </div>

    <script define:vars={{ initCheckedIn: checkedInTickets }}>
      let totalIn = initCheckedIn;
      const statsEl = document.getElementById('stats-in');

      // Search
      const searchEl = document.getElementById('search');
      const rows = document.querySelectorAll('.guest');
      const noResults = document.getElementById('no-results');

      searchEl.addEventListener('input', () => {
        const q = searchEl.value.toLowerCase().trim();
        let visible = 0;
        rows.forEach(row => {
          const match = !q || (row.dataset.name || '').includes(q);
          row.classList.toggle('hidden', !match);
          if (match) visible++;
        });
        noResults.style.display = visible === 0 ? 'block' : 'none';
      });

      // Check-in via event delegation
      document.getElementById('guest-list').addEventListener('click', async (e) => {
        const btn = e.target.closest('[data-action]');
        if (!btn) return;

        const action = btn.dataset.action;
        const id = btn.dataset.id;
        const row = document.getElementById(`g-${id}`);
        if (!row) return;

        // Disable during request
        row.querySelectorAll('button').forEach(b => (b.disabled = true));

        let checked = parseInt(row.dataset.checked, 10);
        const tickets = parseInt(row.dataset.tickets, 10);

        // Optimistic update
        const newChecked = action === 'in'
          ? Math.min(checked + 1, tickets)
          : Math.max(checked - 1, 0);
        applyRow(row, id, newChecked, tickets);
        statsEl.textContent = action === 'in' ? totalIn + 1 : Math.max(totalIn - 1, 0);

        try {
          const res = await fetch('/api/checkin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, action }),
          });
          if (!res.ok) throw new Error('failed');
          totalIn = action === 'in' ? totalIn + 1 : Math.max(totalIn - 1, 0);
          statsEl.textContent = totalIn;
        } catch {
          // Revert on error
          applyRow(row, id, checked, tickets);
          statsEl.textContent = totalIn;
        }
      });

      function applyRow(row, id, checked, tickets) {
        row.dataset.checked = checked;
        row.classList.remove('partial', 'full');
        if (checked > 0 && checked < tickets) row.classList.add('partial');
        else if (checked >= tickets && tickets > 0) row.classList.add('full');

        const el = document.getElementById(`actions-${id}`);
        if (!el) return;

        if (checked === 0) {
          el.innerHTML = `<button class="btn-in" data-action="in" data-id="${id}">Check In</button>`;
        } else if (checked < tickets) {
          el.innerHTML =
            `<span class="badge partial">${checked}/${tickets}</span>` +
            `<button class="btn-in small" data-action="in" data-id="${id}">+</button>` +
            `<button class="btn-undo" data-action="undo" data-id="${id}">−</button>`;
        } else {
          el.innerHTML =
            `<span class="badge full">✓${tickets > 1 ? ` ${tickets}/${tickets}` : ''}</span>` +
            `<button class="btn-undo" data-action="undo" data-id="${id}">−</button>`;
        }
      }
    </script>
  </body>
</html>

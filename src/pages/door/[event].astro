---
import { createClient } from '@supabase/supabase-js';
import QRCode from 'qrcode';

export const prerender = false;

const { event } = Astro.params;
if (!event) return Astro.redirect('/');

const EVENT_CONFIG: Record<string, { walkinLimit: number; stripeUrl: string }> = {
  'march21': { walkinLimit: 20, stripeUrl: 'https://buy.stripe.com/aFadRb9gbfUW0vafoFb3q02' },
  'may5':    { walkinLimit: 30, stripeUrl: '' },
};
const config = EVENT_CONFIG[event] ?? { walkinLimit: 30, stripeUrl: '' };

const supabase = createClient(
  import.meta.env.SUPABASE_URL,
  import.meta.env.SUPABASE_ANON_KEY
);

const { data: guests, error } = await supabase
  .from('guests')
  .select('*')
  .eq('event', event)
  .order('name');

if (error || !guests) {
  return new Response('Could not load guest list', { status: 500 });
}

const totalPeople = guests.reduce((s, g) => s + (g.tickets as number), 0);
const checkedInPeople = guests.reduce((s, g) => s + (g.checked_in_count as number), 0);
const WALKIN_LIMIT = config.walkinLimit;
const walkInCount = guests.filter((g) => g.ticket_type === 'Walk-in').length;

const qrSvg = await QRCode.toString(config.stripeUrl || 'https://blow.nyc', {
  type: 'svg',
  margin: 1,
  color: { dark: '#000000', light: '#ffffff' },
});

function rowClass(checked: number, total: number) {
  if (checked === 0) return '';
  if (checked >= total) return ' full';
  return ' partial';
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <title>Blow — Door</title>
    <link rel="stylesheet" href="https://unpkg.com/98.css" />
  </head>
  <body>
    <div class="window door-window">
      <div class="title-bar">
        <div class="title-bar-text">Blow — Door</div>
      </div>
      <div class="window-body" id="header">
        <div class="header-top">
          <img src="/wordmark.svg" class="logo" alt="Blow" />
          <span id="stats">
            <span id="stats-in">{checkedInPeople}</span> / {totalPeople} people in
          </span>
        </div>
        <div class="search-row field-row">
          <input
            type="search"
            id="search"
            placeholder="Search guests…"
            autocomplete="off"
            autocorrect="off"
            spellcheck="false"
          />
          <button id="qr-toggle">QR</button>
          <button id="add-toggle" disabled={walkInCount >= WALKIN_LIMIT}>+ Add</button>
        </div>
        <div id="walkin-bar">
          Walk-ins: <span id="walkin-count">{walkInCount}</span> / {WALKIN_LIMIT}
          {walkInCount >= WALKIN_LIMIT && <span id="walkin-full"> — FULL</span>}
        </div>
        <div id="add-form" class="add-form hidden">
          <input
            type="text"
            id="add-name"
            placeholder="Guest name"
            autocomplete="off"
            autocorrect="off"
          />
          <button id="add-submit" class="btn-brand">Add</button>
          <button id="add-cancel">Cancel</button>
        </div>
      </div>
    </div>

    <div class="sunken-panel guest-list-panel">
      <div id="guest-list">
        {guests.map((g) => {
          const checked = g.checked_in_count as number;
          const total = g.tickets as number;
          const id = g.id as string;
          return (
            <div
              class={`guest${rowClass(checked, total)}`}
              id={`g-${id}`}
              data-id={id}
              data-checked={checked}
              data-tickets={total}
              data-name={(g.name as string).toLowerCase()}
            >
              <div class="info">
                <div class="name">{g.name}</div>
                {(total > 1 || g.notes || g.ticket_type === 'Walk-in') && (
                  <div class="meta">
                    {g.ticket_type === 'Walk-in' && <span class="pill walkin">Walk-in</span>}
                    {total > 1 && <span class="party-size">Party of {total}</span>}
                    {g.notes && <span class="notes">{g.notes}</span>}
                  </div>
                )}
              </div>
              <div class="actions" id={`actions-${id}`}>
                {checked === 0 && (
                  <button class="btn-in" data-action="in" data-id={id}>Check In</button>
                )}
                {checked > 0 && checked < total && (
                  <>
                    <span class="badge partial">{checked}/{total}</span>
                    <button class="btn-in small" data-action="in" data-id={id}>+</button>
                    <button class="btn-undo" data-action="undo" data-id={id}>−</button>
                  </>
                )}
                {checked >= total && total > 0 && (
                  <>
                    <span class="badge full">✓{total > 1 ? ` ${total}/${total}` : ''}</span>
                    <button class="btn-undo" data-action="undo" data-id={id}>−</button>
                  </>
                )}
              </div>
              <button class="btn-delete" data-action="delete" data-id={id} data-name={g.name as string}>×</button>
            </div>
          );
        })}
        <div id="no-results">No guests found</div>
      </div>
    </div>

    <div id="qr-modal" class="qr-modal hidden">
      <div class="window qr-window">
        <div class="title-bar">
          <div class="title-bar-text">QR Code</div>
          <div class="title-bar-controls">
            <button aria-label="Close" id="qr-close"></button>
          </div>
        </div>
        <div class="window-body qr-body">
          <div class="qr-card" set:html={qrSvg} />
        </div>
      </div>
    </div>

    <div id="pin-modal" class="pin-modal hidden">
      <div class="window pin-window">
        <div class="title-bar">
          <div class="title-bar-text">PIN Required</div>
          <div class="title-bar-controls">
            <button aria-label="Close" id="pin-close-x"></button>
          </div>
        </div>
        <div class="window-body pin-body">
          <div class="pin-title" id="pin-title">Enter PIN to add guest</div>
          <input type="password" id="pin-input" inputmode="numeric" maxlength="4" placeholder="••••" />
          <div class="pin-error hidden" id="pin-error">Incorrect PIN</div>
          <div class="pin-buttons">
            <button id="pin-cancel">Cancel</button>
            <button id="pin-submit" class="btn-brand">OK</button>
          </div>
        </div>
      </div>
    </div>

    <script define:vars={{ initCheckedIn: checkedInPeople, totalPeople, currentEvent: event, initWalkIns: walkInCount, walkinLimit: WALKIN_LIMIT }}>
      let peopleIn = initCheckedIn;
      let walkIns = initWalkIns;
      const statsEl = document.getElementById('stats-in');
      const walkinCountEl = document.getElementById('walkin-count');
      const addToggle = document.getElementById('add-toggle');

      function updateWalkinBar() {
        walkinCountEl.textContent = walkIns;
        const full = walkIns >= walkinLimit;
        addToggle.disabled = full;
        let fullEl = document.getElementById('walkin-full');
        if (full && !fullEl) {
          fullEl = document.createElement('span');
          fullEl.id = 'walkin-full';
          fullEl.textContent = ' — FULL';
          document.getElementById('walkin-bar').appendChild(fullEl);
        } else if (!full && fullEl) {
          fullEl.remove();
        }
      }

      // Search
      const searchEl = document.getElementById('search');
      const noResults = document.getElementById('no-results');

      function getRows() {
        return document.querySelectorAll('.guest');
      }

      searchEl.addEventListener('input', () => {
        const q = searchEl.value.toLowerCase().trim();
        let visible = 0;
        getRows().forEach(row => {
          const match = !q || (row.dataset.name || '').includes(q);
          row.classList.toggle('hidden', !match);
          if (match) visible++;
        });
        noResults.style.display = visible === 0 ? 'block' : 'none';
      });

      // QR fullscreen
      const qrModal = document.getElementById('qr-modal');
      document.getElementById('qr-toggle').addEventListener('click', (e) => {
        e.stopPropagation();
        qrModal.classList.remove('hidden');
      });
      qrModal.addEventListener('click', () => qrModal.classList.add('hidden'));
      qrModal.querySelector('.qr-card').addEventListener('click', (e) => e.stopPropagation());
      qrModal.querySelector('.qr-window').addEventListener('click', (e) => e.stopPropagation());
      const qrCloseBtn = document.getElementById('qr-close');
      if (qrCloseBtn) qrCloseBtn.addEventListener('click', () => qrModal.classList.add('hidden'));

      // PIN modal — generic, calls pinCallback on success
      const PIN = '0803';
      const pinModal = document.getElementById('pin-modal');
      const pinInput = document.getElementById('pin-input');
      const pinError = document.getElementById('pin-error');
      const pinSubmit = document.getElementById('pin-submit');
      const pinCancel = document.getElementById('pin-cancel');
      let pinCallback = null;

      const pinTitle = document.getElementById('pin-title');

      function openPin(callback, label = 'add guest') {
        pinCallback = callback;
        pinTitle.textContent = `Enter PIN to ${label}`;
        pinInput.value = '';
        pinError.classList.add('hidden');
        pinModal.classList.remove('hidden');
        pinInput.focus();
      }

      function checkPin() {
        if (pinInput.value === PIN) {
          pinModal.classList.add('hidden');
          if (pinCallback) { pinCallback(); pinCallback = null; }
        } else {
          pinError.classList.remove('hidden');
          pinInput.value = '';
          pinInput.focus();
        }
      }

      pinSubmit.addEventListener('click', checkPin);
      pinInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') checkPin(); });
      pinCancel.addEventListener('click', () => {
        pinModal.classList.add('hidden');
        pinCallback = null;
        pinInput.value = '';
        pinError.classList.add('hidden');
      });

      // PIN close X button
      const pinCloseX = document.getElementById('pin-close-x');
      if (pinCloseX) pinCloseX.addEventListener('click', () => {
        pinModal.classList.add('hidden');
        pinCallback = null;
        pinInput.value = '';
        pinError.classList.add('hidden');
      });

      // Add guest form toggle
      const addForm = document.getElementById('add-form');
      const addName = document.getElementById('add-name');
      const addSubmit = document.getElementById('add-submit');
      const addCancel = document.getElementById('add-cancel');

      addToggle.addEventListener('click', () => {
        openPin(() => { addForm.classList.remove('hidden'); addName.focus(); });
      });

      addCancel.addEventListener('click', () => {
        addForm.classList.add('hidden');
        addName.value = '';
      });

      addSubmit.addEventListener('click', () => submitAddGuest());
      addName.addEventListener('keydown', (e) => { if (e.key === 'Enter') submitAddGuest(); });

      async function submitAddGuest() {
        const name = addName.value.trim();
        if (!name) { addName.focus(); return; }
        if (walkIns >= walkinLimit) {
          alert(`Walk-in limit of ${walkinLimit} reached.`);
          return;
        }

        addSubmit.disabled = true;
        addSubmit.textContent = '…';

        try {
          const res = await fetch('/api/add-guest', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ event: currentEvent, name }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error);

          const g = data.guest;
          const div = document.createElement('div');
          div.className = 'guest new-guest';
          div.id = `g-${g.id}`;
          div.dataset.id = g.id;
          div.dataset.checked = '0';
          div.dataset.tickets = '1';
          div.dataset.name = g.name.toLowerCase();
          div.innerHTML =
            `<div class="info"><div class="name">${esc(g.name)}</div>` +
            `<div class="meta"><span class="pill walkin">Walk-in</span></div></div>` +
            `<div class="actions" id="actions-${g.id}">` +
            `<button class="btn-in" data-action="in" data-id="${g.id}">Check In</button>` +
            `</div>` +
            `<button class="btn-delete" data-action="delete" data-id="${g.id}" data-name="${esc(g.name)}">×</button>`;

          const list = document.getElementById('guest-list');
          list.insertBefore(div, list.firstChild);

          walkIns++;
          updateWalkinBar();

          addName.value = '';
          addForm.classList.add('hidden');
        } catch (err) {
          alert('Could not add guest: ' + err.message);
        } finally {
          addSubmit.disabled = false;
          addSubmit.textContent = 'Add';
        }
      }

      function esc(str) {
        return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }

      // Check-in + delete via event delegation
      document.getElementById('guest-list').addEventListener('click', async (e) => {
        const btn = e.target.closest('[data-action]');
        if (!btn) return;

        const action = btn.dataset.action;
        const id = btn.dataset.id;

        if (action === 'delete') {
          const name = btn.dataset.name || 'this guest';
          openPin(async () => {
            const row = document.getElementById(`g-${id}`);
            const checkedCount = row ? parseInt(row.dataset.checked, 10) : 0;
            const isWalkin = row ? row.querySelector('.pill.walkin') !== null : false;
            try {
              const res = await fetch('/api/delete-guest', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id }),
              });
              if (!res.ok) throw new Error('failed');
              if (row) row.remove();
              peopleIn = Math.max(peopleIn - checkedCount, 0);
              statsEl.textContent = peopleIn;
              if (isWalkin) { walkIns = Math.max(walkIns - 1, 0); updateWalkinBar(); }
            } catch {
              alert('Could not remove ' + name);
            }
          }, 'remove guest');
          return;
        }
        const row = document.getElementById(`g-${id}`);
        if (!row) return;

        row.querySelectorAll('button').forEach(b => (b.disabled = true));

        const checked = parseInt(row.dataset.checked, 10);
        const tickets = parseInt(row.dataset.tickets, 10);

        const newChecked = action === 'in'
          ? Math.min(checked + 1, tickets)
          : Math.max(checked - 1, 0);

        applyRow(row, id, newChecked, tickets);
        statsEl.textContent = action === 'in' ? peopleIn + 1 : Math.max(peopleIn - 1, 0);

        try {
          const res = await fetch('/api/checkin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, action }),
          });
          if (!res.ok) throw new Error('failed');
          peopleIn = action === 'in' ? peopleIn + 1 : Math.max(peopleIn - 1, 0);
          statsEl.textContent = peopleIn;
        } catch {
          applyRow(row, id, checked, tickets);
          statsEl.textContent = peopleIn;
        }
      });

      function applyRow(row, id, checked, tickets) {
        row.dataset.checked = checked;
        row.classList.remove('partial', 'full');
        if (checked > 0 && checked < tickets) row.classList.add('partial');
        else if (checked >= tickets && tickets > 0) row.classList.add('full');

        const el = document.getElementById(`actions-${id}`);
        if (!el) return;

        if (checked === 0) {
          el.innerHTML = `<button class="btn-in" data-action="in" data-id="${id}">Check In</button>`;
        } else if (checked < tickets) {
          el.innerHTML =
            `<span class="badge partial">${checked}/${tickets}</span>` +
            `<button class="btn-in small" data-action="in" data-id="${id}">+</button>` +
            `<button class="btn-undo" data-action="undo" data-id="${id}">−</button>`;
        } else {
          el.innerHTML =
            `<span class="badge full">✓${tickets > 1 ? ` ${tickets}/${tickets}` : ''}</span>` +
            `<button class="btn-undo" data-action="undo" data-id="${id}">−</button>`;
        }
      }
    </script>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Pixelated MS Sans Serif', Arial, sans-serif;
    background: var(--surface-dark, #000080);
    color: var(--text-light, #ffffff);
  }

  /* Door window — full width, no max */
  .door-window {
    width: 100%;
    max-width: 100%;
  }

  .door-window .title-bar {
    background: var(--surface-dark, #000080);
  }

  .door-window .title-bar-text {
    color: var(--text-light, #ffffff);
  }

  #header {
    background: var(--surface-darker, #000058);
    padding: 8px;
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .logo {
    height: 26px;
    width: auto;
    filter: brightness(0) invert(1);
  }

  #stats {
    font-size: var(--font-size-base, 13px);
    color: var(--text-muted, #808080);
  }

  #stats-in {
    color: var(--text-light, #ffffff);
    font-weight: 700;
  }

  .search-row {
    display: flex;
    gap: 4px;
  }

  #search {
    flex: 1;
    padding: 4px 6px;
    font-size: 16px;
  }

  #qr-toggle {
    padding: 0 10px;
    font-size: var(--font-size-base, 13px);
    font-weight: 600;
    min-height: 28px;
  }

  #add-toggle {
    padding: 0 10px;
    font-size: var(--font-size-base, 13px);
    font-weight: 600;
    min-height: 28px;
  }

  #add-toggle:disabled { opacity: 0.4; cursor: not-allowed; }

  #walkin-bar {
    font-size: var(--font-size-sm, 11px);
    color: var(--text-muted, #808080);
    margin-top: 6px;
    text-align: right;
  }

  #walkin-full {
    color: var(--blow-red, #ff2845);
    font-weight: 700;
  }

  .add-form {
    display: flex;
    gap: 4px;
    margin-top: 6px;
  }

  .add-form.hidden { display: none; }

  #add-name {
    flex: 1;
    padding: 4px 6px;
    font-size: 16px;
  }

  #add-submit {
    padding: 0 12px;
    font-weight: 700;
    min-height: 28px;
  }

  .btn-brand {
    background: var(--blow-red, #ff2845);
    color: var(--text-light, #ffffff);
    border: none;
  }

  .btn-brand:active {
    background: var(--blow-red-dark, #cc1f37);
  }

  /* Guest list panel */
  .guest-list-panel {
    margin: 2px 0;
    background: var(--win98-bg, #c0c0c0);
    overflow-y: auto;
    height: calc(100vh - 200px);
  }

  #guest-list { padding: 0; }

  .guest {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 8px;
    background: var(--win98-white, #ffffff);
    border-bottom: 1px solid var(--win98-border-dark, #808080);
    min-height: 48px;
    color: #000000;
  }

  .guest.partial { background: #fff8e1; }
  .guest.full    { background: #e8f5e9; }
  .guest.hidden  { display: none; }

  .guest.new-guest {
    border-left: 3px solid var(--blow-red, #ff2845);
  }

  .info {
    flex: 1;
    min-width: 0;
    padding-right: 8px;
  }

  .name {
    font-size: var(--font-size-lg, 16px);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #000000;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 2px;
    align-items: baseline;
  }

  .pill {
    font-size: var(--font-size-sm, 11px);
    font-weight: 700;
    padding: 1px 6px;
    border: 1px solid var(--win98-border-dark, #808080);
  }

  .pill.walkin {
    background: #e8f0fe;
    color: #1a56db;
  }

  .party-size {
    font-size: var(--font-size-sm, 11px);
    font-weight: 700;
    background: var(--win98-bg, #c0c0c0);
    color: #000000;
    padding: 1px 6px;
    border: 1px solid var(--win98-border-dark, #808080);
  }

  .notes {
    font-size: var(--font-size-sm, 11px);
    color: var(--text-muted, #808080);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  /* Override 98.css button base for door page */
  .guest button,
  .add-form button,
  .search-row button,
  .pin-buttons button {
    cursor: pointer;
    font-size: var(--font-size-base, 13px);
    font-weight: 700;
    min-height: 28px;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .btn-in {
    background: var(--blow-red, #ff2845);
    color: var(--text-light, #ffffff);
    border: none;
    padding: 4px 12px;
    min-height: 28px;
  }

  .btn-in:active { background: var(--blow-red-dark, #cc1f37); }

  .btn-in.small {
    font-size: 18px;
    padding: 4px 10px;
  }

  .btn-undo {
    font-size: 18px;
    padding: 4px 10px;
    min-height: 28px;
  }

  button:disabled { opacity: 0.4; }

  .badge {
    font-size: var(--font-size-base, 13px);
    font-weight: 700;
    padding: 2px 8px;
    white-space: nowrap;
    border: 1px solid var(--win98-border-dark, #808080);
  }

  .badge.partial { background: #ffca28; color: #333; }
  .badge.full    { background: #43a047; color: white; }

  .btn-delete {
    background: none;
    border: none;
    color: var(--text-muted, #808080);
    font-size: 16px;
    font-weight: 400;
    padding: 0 4px 0 8px;
    min-height: 28px;
    flex-shrink: 0;
    cursor: pointer;
  }

  .btn-delete:active { color: var(--blow-red, #ff2845); }

  /* QR modal — 98.css window chrome */
  .qr-modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 200;
    cursor: pointer;
  }

  .qr-modal.hidden { display: none; }

  .qr-window {
    width: min(85vw, 85vh);
    cursor: default;
  }

  .qr-body {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
  }

  .qr-card {
    background: white;
    padding: 12px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .qr-card svg {
    width: 100%;
    height: 100%;
  }

  /* PIN modal — 98.css window chrome */
  .pin-modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
  }

  .pin-modal.hidden { display: none; }

  .pin-window {
    width: 280px;
  }

  .pin-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px;
  }

  .pin-title {
    font-size: var(--font-size-base, 13px);
    font-weight: 600;
    text-align: center;
  }

  #pin-input {
    width: 100%;
    padding: 4px 6px;
    font-size: 18px;
    text-align: center;
    letter-spacing: 0.3em;
  }

  .pin-error {
    font-size: var(--font-size-base, 13px);
    color: var(--blow-red, #ff2845);
    text-align: center;

---
import '../styles/tokens.css';

interface Props {
  title?: string;
}

const { title = 'Blow Admin' } = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="stylesheet" href="https://unpkg.com/98.css" />
  </head>
  <body>
    <div class="admin-desktop">
      <div class="window admin-window">
        <div class="title-bar">
          <div class="title-bar-text">{title}</div>
          <div class="title-bar-controls">
            <a href="/" class="logout-link" aria-label="Logout">Logout</a>
          </div>
        </div>
        <div class="window-body admin-body">
          <slot />
        </div>
      </div>

      <div class="admin-tabs">
        <a href="/admin" class={`admin-tab${currentPath === '/admin' || currentPath === '/admin/' ? ' active' : ''}`}>Dashboard</a>
        <a href="/admin/events" class={`admin-tab${currentPath.startsWith('/admin/events') ? ' active' : ''}`}>Events</a>
      </div>
    </div>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--win98-bg, #c0c0c0);
    font-family: var(--font-system, 'Pixelated MS Sans Serif', Arial, sans-serif);
  }

  .admin-desktop {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    padding-bottom: 36px;
  }

  .admin-window {
    width: 100%;
    flex: 1;
  }

  .admin-window .title-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .admin-body {
    padding: var(--space-md, 16px);
    min-height: calc(100vh - 80px);
  }

  .logout-link {
    color: var(--text-light, #ffffff);
    text-decoration: none;
    font-size: var(--font-size-sm, 11px);
    padding: 0 8px;
    font-weight: bold;
  }

  .logout-link:hover {
    text-decoration: underline;
  }

  .admin-tabs {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 36px;
    background: var(--win98-bg, #c0c0c0);
    border-top: 2px solid var(--win98-border-light, #ffffff);
    display: flex;
    align-items: center;
    padding: 2px 4px;
    gap: 2px;
    z-index: 1000;
  }

  .admin-tab {
    display: flex;
    align-items: center;
    padding: 2px 16px;
    font-size: var(--font-size-sm, 11px);
    font-family: var(--font-system, 'Pixelated MS Sans Serif', Arial, sans-serif);
    font-weight: bold;
    background: var(--win98-bg, #c0c0c0);
    border: 2px solid;
    border-color: var(--win98-border-light, #ffffff) var(--win98-border-dark, #808080) var(--win98-border-dark, #808080) var(--win98-border-light, #ffffff);
    cursor: pointer;
    min-height: 24px;
    text-decoration: none;
    color: inherit;
  }

  .admin-tab.active {
    background: var(--win98-white, #ffffff);
    border-bottom-color: var(--win98-white, #ffffff);
  }
</style>

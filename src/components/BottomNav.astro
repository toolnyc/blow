---
interface MenuItem {
  id: string;
  title: string;
  icon?: string;
}

interface Props {
  menuItems?: MenuItem[];
}

const { menuItems = [] } = Astro.props;
---

<nav class="bottom-nav">
  {menuItems.map((item) => (
    <button class="bottom-nav-item" data-open-window={item.id}>
      {item.icon && <img src={item.icon} alt="" class="nav-icon" />}
      <span>{item.title}</span>
    </button>
  ))}
</nav>

<style>
  .bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 36px;
    background: #c0c0c0;
    border-top: 2px solid #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
    padding: 2px 4px;
    z-index: 1000;
  }

  .bottom-nav-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    flex: 1;
    max-width: 140px;
    padding: 2px 8px;
    font-size: 11px;
    font-family: 'Pixelated MS Sans Serif', Arial, sans-serif;
    font-weight: bold;
    text-decoration: none;
    color: #000000;
    background: #c0c0c0;
    border: 2px solid;
    border-color: #ffffff #808080 #808080 #ffffff;
    cursor: pointer;
    min-height: 24px;
    text-align: center;
    white-space: nowrap;
  }

  .bottom-nav-item:active {
    border-color: #808080 #ffffff #ffffff #808080;
  }

  .bottom-nav-item:hover {
    background: #d4d4d4;
  }

  .nav-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
</style>
